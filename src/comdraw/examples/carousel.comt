// src/comdraw/examples/carousel.comt -- a 3D-ish coverflow photo carousel.
//
// Lays out 5 visible slots in an arc: the center slot is full-size, and
// each slot further out shrinks and drops slightly, giving the appearance
// of photos receding away from the viewer. Run this once to build the
// library and lay out the first 5 photos, then call carousel.next()/
// carousel.prev() as many times as you like to spin it either way: next()
// exits a photo past the back and spins the next library photo in from
// the back; prev() is its exact mirror, exiting past the front and
// spinning the previous library photo in from the front.
//
//   run("src/comdraw/examples/carousel.comt")
//   carousel.next()   // repeat to keep spinning forward
//   carousel.prev()   // ...or backward
//   carouseldrive()   // or drive it with Shift/CapsLock + left/right arrow
//
// carousel is one object (same bundling-data-and-behavior idiom as
// zoomap.comt's zoo) rather than a script re-run with run(): next is a
// func value parsed once, when carousel is built, and every later
// carousel.next() call just executes that already-parsed postfix again --
// no re-read, re-parse of a file per advance. The deck (d0..d4, nextlib,
// img0..img4) lives as fields on carousel itself, since a func's plain
// assignments only persist back into fields of the SAME attrlist it was
// called through (carousel.next()'s own d0=d1 etc.) -- writing to a
// variable outside that object, from inside a func, would need local()
// instead (see etchasketch.comt), and wouldn't give an outside caller
// anything to read back afterwards anyway. A shell loop, a key binding, or
// a timer-driven remote() call can all repeat carousel.next() to keep it
// spinning. (Driving each advance from outside like this, rather than an
// internal loop inside next() itself, sidesteps a separate finding from
// building this: nesting the animation's own for/while in one more outer
// for() hangs comterp's postfix re-evaluation -- see the PR description.)
//
// Each library photo is fetched live via curl when the network is
// reachable, each with a distinct cache-busting x= value so the same
// random-photo endpoint doesn't hand back the same image twice (see
// fetchphoto below). The cache-busting counter starts at 100 rather than
// 0 so a later import(:next) call never needs to carry a digit past the
// field's current width -- see issue #612 for what goes wrong when it
// does. JPEG/PNG/GIF import shells out to djpeg/pngtopnm/giftopnm (see
// OvImportCmd::Import), so those need to be on PATH for the live path.
//
// A photo whose fetch fails (no network, endpoint unreachable, etc.)
// falls back to a solid-color 1x1 raster stand-in -- fetchphoto() checks
// each import(:popen) result and switches per photo, so the example and
// its regression test behave the same with or without a live network.
//
// Each of the initial 5 visible photos is placed into its slot and shown
// (update()) as soon as it arrives, so the deck fills in one photo at a
// time rather than appearing all at once after every fetch completes.
// The remaining library photos (not yet part of the visible deck) are
// moved off-canvas the moment they're imported (park(), below) instead
// of sitting at whatever position import() happened to paste them at.
//
// trans()'s scale factors apply to a graphic's own native pixel geometry,
// not to its slot's target size directly -- a photo's native width/height
// varies with whatever the fetch returned, so a scale of exactly (target
// width, target height) would only be correct by coincidence. libw/libh
// (captured once per library photo, right after import, via mbr() before
// any trans() call ever runs) hold each photo's native size; every trans()
// call below divides the slot's target width/height by the occupying
// photo's native width/height to get the actual scale factor. (This also
// means a plain 1x1-raster stand-in still works unmodified if libw/libh
// are seeded with 1,1 for it -- scale reduces to the old literal-size
// behavior exactly.)
//
// trans()'s six-value tuple argument must be bare variables, not inline
// expressions, parenthesized sub-expressions, or function calls -- any of
// those make it silently fall back to its getter instead of setting (see
// the PR description for carousel's original version). Every trans() call
// below stages its six values into plain variables first for exactly that
// reason.

// each import() below selects the photo it just pasted in, so without
// this the selection tic-marks would flash on and off around every
// photo as the deck builds; restored at the end of the script, once the
// deck is up and nothing is being imported anymore
prevhandles=handles(:get); handles(0)

CENTERX=427; CENTERY=550
BASEW=240; BASEH=160
// each carousel.next() walks 6 interpolated steps from a slot's starting
// position to its ending position, paced by update() at 24fps (usec=1e6/24)
FR=6
USEC=41667

offX0=(0-330); offX1=(0-180); offX2=0; offX3=180; offX4=330
sc0=0.42; sc1=0.65; sc2=1.0; sc3=0.65; sc4=0.42
lift0=40; lift1=20; lift2=0; lift3=20; lift4=40

// slotw/sloth/slotcx/slotcy(j) -- the (w,h,centerx,centery) a photo takes
// on when it sits in slot j (0=leftmost/farthest .. 4=rightmost/farthest,
// 2=center/frontmost)
slotw=func(
  j=arg(0);
  s=if(j==0 :then sc0 :else if(j==1 :then sc1 :else if(j==2 :then sc2 :else if(j==3 :then sc3 :else sc4))));
  w=BASEW*s;
  w)
sloth=func(
  j=arg(0);
  s=if(j==0 :then sc0 :else if(j==1 :then sc1 :else if(j==2 :then sc2 :else if(j==3 :then sc3 :else sc4))));
  h=BASEH*s;
  h)
slotcx=func(
  j=arg(0);
  o=if(j==0 :then offX0 :else if(j==1 :then offX1 :else if(j==2 :then offX2 :else if(j==3 :then offX3 :else offX4))));
  cx=CENTERX+o;
  cx)
slotcy=func(
  j=arg(0);
  l=if(j==0 :then lift0 :else if(j==1 :then lift1 :else if(j==2 :then lift2 :else if(j==3 :then lift3 :else lift4))));
  cy=CENTERY-l;
  cy)

// place(img j pw ph) -- move img to slot j's position/scale, absolute
// (trans :set); pw/ph is img's own native pixel size, so the scale factor
// is relative to that, not to the slot's target size directly (see header)
place=func(
  img=arg(0); j=arg(1); pw=arg(2); ph=arg(3);
  w=slotw(j); h=sloth(j); cx=slotcx(j); cy=slotcy(j);
  sx=w/pw; sy=h/ph;
  hw=w/2; hh=h/2;
  tx=cx-hw; ty=cy-hh;
  trans(img sx,0,0,sy,tx,ty :set);
  nil)

// fixed endpoints for the exit (past slot 0, off to the left) and entrance
// (from further right/back than slot 4) legs of the animation -- computed
// once since they never depend on which photo occupies the slot
exfromw=slotw(0); exfromh=sloth(0); exfromcx=slotcx(0); exfromcy=slotcy(0)
extow=42; extoh=28; extocx=(0-480); extocy=CENTERY-60
enfromw=25; enfromh=17; enfromcx=CENTERX+(CENTERX-extocx); enfromcy=CENTERY-60
entow=slotw(4); entoh=sloth(4); entocx=slotcx(4); entocy=slotcy(4)

// carousel.prev()'s endpoints are exfrom/extow/en(from/to) mirrored left-
// right around CENTERX, reusing each pair's own size unchanged -- an exit
// always ends at extow,extoh's size, an entrance always starts at
// enfromw,enfromh's size, whichever direction it spins
revextow=extow; revextoh=extoh; revextocx=enfromcx; revextocy=extocy
revenfromw=enfromw; revenfromh=enfromh; revenfromcx=extocx; revenfromcy=enfromcy

// park(img pw ph) -- move img to the entrance-staging spot (the same
// off-canvas position carousel.next()'s entrant animation starts from,
// "further back than slot 4") -- where a library photo not yet part of
// the visible 5-slot deck sits until next() spins it in, instead of
// wherever import() happened to paste it; pw/ph is img's own native
// pixel size
park=func(
  img=arg(0); pw=arg(1); ph=arg(2);
  sx=enfromw/pw; sy=enfromh/ph;
  hw=enfromw/2; hh=enfromh/2;
  tx=enfromcx-hw; ty=enfromcy-hh;
  trans(img sx,0,0,sy,tx,ty :set);
  nil)

// fetchphoto(idx) -- live-fetch library photo idx via curl; if that
// import fails (no network, endpoint unreachable, empty/unrecognized
// output), fall back to library slot idx's solid-color stand-in instead.
photocolors=0xd94f4f,0xd9a54f,0xd9d24f,0x6fd94f,0x4fb8d9,0x6f4fd9,0xd94fbb
fetchphoto=func(
  idx=arg(0);
  url="curl -s --max-time 3 --output - -L \"https://api.sourcesplash.com/i/random?q=beach?x="+print(100+idx :str)+"\"";
  img=import(url :popen);
  img=if(img==nil :then raster(0,0,1,1 :rgb 1,1, at(photocolors idx)) :else img);
  img)

// photo library: n photos, each fetched live via curl or, on failure, a
// solid-color 1x1 stand-in (see fetchphoto above); libw/libh hold each
// photo's own native pixel size (see header), captured immediately after
// import via mbr() (l,b,r,t) before any trans() call establishes a
// placement -- a 1x1 stand-in's own mbr() naturally yields 1,1, so the
// same capture and the same trans() scaling apply unchanged to either
// kind of photo, no separate case needed. The first 5 (the initial
// visible deck) are placed into their slot and shown via update() as
// each one arrives; the rest are parked off-canvas immediately instead
// of appearing at import()'s own paste position.
n=7
img0lib=fetchphoto(0);
b0=mbr(img0lib); pw0=at(b0 2)-at(b0 0); ph0=at(b0 3)-at(b0 1);
imgs=img0lib; libw=pw0; libh=ph0;
place(img0lib 0 pw0 ph0); update();
for(i=1 i<n i=i+1
  imgi=fetchphoto(i);
  bi=mbr(imgi); pwi=at(bi 2)-at(bi 0); phi=at(bi 3)-at(bi 1);
  imgs=imgs,imgi;
  libw=libw,pwi;
  libh=libh,phi;
  // slot geometry only overlaps at the two center/neighbor seams (1-2 and
  // 3-2); every other pair of slots is spaced apart. Slot 1 is placed
  // before slot 2, so it already pastes underneath center with no fixup.
  // Slot 3 pastes after, so without this it would cover center's edge --
  // re-fronting center right after is the only correction this loop needs.
  if(i<5 :then
    place(imgi i pwi phi);
    if(i==3 :then front(at(imgs 2)));
    update()
   :else park(imgi pwi phi)))
print("carousel: built %v photos\n" n)

// carousel -- the deck (which library photo, by index, occupies each of
// the 5 slots, and which library photo spins in next) plus the one method
// that advances it. next()'s plain assignments to d0..d4/nextlib/img0..
// img4 persist across calls because they land on carousel's own fields --
// see the header note above.
carousel=(
  :d0 0 :d1 1 :d2 2 :d3 3 :d4 4 :nextlib 5
  :img0 at(imgs 0) :img1 at(imgs 1) :img2 at(imgs 2) :img3 at(imgs 3) :img4 at(imgs 4)

  // carousel.next() -- advance by one photo: the front photo exits past
  // the back, everything else slides one slot forward, and the next
  // library photo spins in from the back to fill the gap.
  :next func(
    exiting=img0;
    entrant=at(imgs nextlib);
    expw=at(libw d0); exph=at(libh d0);
    enpw=at(libw nextlib); enph=at(libh nextlib);

    for(f=1 f<=FR f=f+1
      t=f/float(FR);

      // slots 0..3 <- what was in slots 1..4, sliding one slot forward
      s=0;
      while(s<4
        src=s+1;
        im=if(src==1 :then img1 :else if(src==2 :then img2 :else if(src==3 :then img3 :else img4)));
        srcidx=if(src==1 :then d1 :else if(src==2 :then d2 :else if(src==3 :then d3 :else d4)));
        pw=at(libw srcidx); ph=at(libh srcidx);
        fw=slotw(src); fh=sloth(src); fcx=slotcx(src); fcy=slotcy(src);
        tw=slotw(s); th=sloth(s); tcx=slotcx(s); tcy=slotcy(s);
        w=fw+(tw-fw)*t; h=fh+(th-fh)*t;
        cx=fcx+(tcx-fcx)*t; cy=fcy+(tcy-fcy)*t;
        sx=w/pw; sy=h/ph;
        hw=w/2; hh=h/2; tx=cx-hw; ty=cy-hh;
        trans(im sx,0,0,sy,tx,ty :set);
        if(s==1 :then leftw=w);
        if(s==2 :then centerw=w; centerimg=im);
        s=s+1);

      // bring the growing center-bound photo in front the moment it
      // overtakes its left neighbor in size, rather than waiting for the
      // whole walk to finish and fixing z-order only once at the end
      if(centerw>leftw :then front(centerimg));

      // the exiting photo continues receding past the back
      ew=exfromw+(extow-exfromw)*t; eh=exfromh+(extoh-exfromh)*t;
      ecx=exfromcx+(extocx-exfromcx)*t; ecy=exfromcy+(extocy-exfromcy)*t;
      esx=ew/expw; esy=eh/exph;
      ehw=ew/2; ehh=eh/2; etx=ecx-ehw; ety=ecy-ehh;
      trans(exiting esx,0,0,esy,etx,ety :set);

      // the entrant spins in from further back into slot 4
      nw=enfromw+(entow-enfromw)*t; nh=enfromh+(entoh-enfromh)*t;
      ncx=enfromcx+(entocx-enfromcx)*t; ncy=enfromcy+(entocy-enfromcy)*t;
      nsx=nw/enpw; nsy=nh/enph;
      nhw=nw/2; nhh=nh/2; ntx=ncx-nhw; nty=ncy-nhh;
      trans(entrant nsx,0,0,nsy,ntx,nty :set);

      update(USEC));

    d0=d1; d1=d2; d2=d3; d3=d4; d4=nextlib;
    img0=img1; img1=img2; img2=img3; img3=img4; img4=entrant;
    nextlib=mod(d4+1 n);
    front(img0); front(img4); front(img1); front(img3); front(img2);
    nil)

  // carousel.prev() -- spin the other way: the back photo exits past the
  // front, everything else slides one slot backward, and the library
  // photo just before the current deck spins in from the front to fill
  // the gap. Exact mirror image of next() -- see its comment above.
  :prev func(
    exiting=img4;
    entlib=mod(d0-1+n n);
    entrant=at(imgs entlib);
    expw=at(libw d4); exph=at(libh d4);
    enpw=at(libw entlib); enph=at(libh entlib);

    for(f=1 f<=FR f=f+1
      t=f/float(FR);

      // slots 4..1 <- what was in slots 3..0, sliding one slot backward
      s=4;
      while(s>0
        src=s-1;
        im=if(src==3 :then img3 :else if(src==2 :then img2 :else if(src==1 :then img1 :else img0)));
        srcidx=if(src==3 :then d3 :else if(src==2 :then d2 :else if(src==1 :then d1 :else d0)));
        pw=at(libw srcidx); ph=at(libh srcidx);
        fw=slotw(src); fh=sloth(src); fcx=slotcx(src); fcy=slotcy(src);
        tw=slotw(s); th=sloth(s); tcx=slotcx(s); tcy=slotcy(s);
        w=fw+(tw-fw)*t; h=fh+(th-fh)*t;
        cx=fcx+(tcx-fcx)*t; cy=fcy+(tcy-fcy)*t;
        sx=w/pw; sy=h/ph;
        hw=w/2; hh=h/2; tx=cx-hw; ty=cy-hh;
        trans(im sx,0,0,sy,tx,ty :set);
        if(s==3 :then rightw=w);
        if(s==2 :then centerw=w; centerimg=im);
        s=s-1);

      if(centerw>rightw :then front(centerimg));

      // the exiting photo (was slot 4) continues receding past the back,
      // now off to the right
      ew=entow+(revextow-entow)*t; eh=entoh+(revextoh-entoh)*t;
      ecx=entocx+(revextocx-entocx)*t; ecy=entocy+(revextocy-entocy)*t;
      esx=ew/expw; esy=eh/exph;
      ehw=ew/2; ehh=eh/2; etx=ecx-ehw; ety=ecy-ehh;
      trans(exiting esx,0,0,esy,etx,ety :set);

      // the entrant spins in from further back on the left into slot 0
      nw=revenfromw+(exfromw-revenfromw)*t; nh=revenfromh+(exfromh-revenfromh)*t;
      ncx=revenfromcx+(exfromcx-revenfromcx)*t; ncy=revenfromcy+(exfromcy-revenfromcy)*t;
      nsx=nw/enpw; nsy=nh/enph;
      nhw=nw/2; nhh=nh/2; ntx=ncx-nhw; nty=ncy-nhh;
      trans(entrant nsx,0,0,nsy,ntx,nty :set);

      update(USEC));

    d4=d3; d3=d2; d2=d1; d1=d0; d0=entlib;
    img4=img3; img3=img2; img2=img1; img1=img0; img0=entrant;
    nextlib=mod(d4+1 n);
    front(img0); front(img4); front(img1); front(img3); front(img2);
    nil)
)

// carouseldrive([n]) -- drive the carousel with the keyboard: hold Shift
// (or turn Caps Lock on) and press left/right arrow to spin it, the same
// shift-capture convention etchasketch.comt's keydrive() uses so plain
// arrows keep panning the viewer normally. Esc stops early.
carouseldrive=func(
  n=arg(0);
  if(n==nil :then n=1000);
  lastkey(:shiftcapture true);
  print("CAROUSEL DRIVE -- hold Shift or turn Caps Lock on, then LEFT/RIGHT arrow to spin.  Esc stops.\n");
  done=0;
  for(fi=0 (fi<n)&&(done==0) fi=fi+1
    k=lastkey();
    while((k!=nil)&&(done==0)
      if((k=="Esc")||(k=="ESC") :then done=1);
      if(k=="RIGHT" :then carousel.next());
      if(k=="LEFT" :then carousel.prev());
      k=lastkey());
    update(30000));
  lastkey(:shiftcapture false);
  print("Done driving.\n"))

// slots were already placed, shown, and re-fronted into depth order one at
// a time during the library loop above
print("carousel: initial deck %v %v %v %v %v\n" carousel.d0 carousel.d1 carousel.d2 carousel.d3 carousel.d4)
handles(prevhandles)
update()
