// src/comdraw/examples/carousel.comt -- a 3D-ish coverflow photo carousel.
//
// Lays out 5 visible slots in an arc: the center slot is full-size, and
// each slot further out shrinks and drops slightly, giving the appearance
// of photos receding away from the viewer. Run this once to build the
// library and lay out the first 5 photos, then re-run carousel_next.comt
// as many times as you like to spin the carousel: the front photo exits
// past the back, everything else slides one slot forward, and a new photo
// (reused circularly from the library) spins in from the back to fill the
// gap.
//
//   run("src/comdraw/examples/carousel.comt")
//   run("src/comdraw/examples/carousel_next.comt")   // repeat to keep spinning
//
// The two steps are separate files rather than one script with an internal
// loop: wrapping the animation's own for/while nesting in one more outer
// for() loop was observed to hang comterp's postfix re-evaluation, so each
// advance is driven from outside instead -- see the PR description for
// this finding. A shell loop, a key binding, or a timer-driven remote()
// call can all replay carousel_next.comt to keep it spinning.
//
// Photos here are solid-color 1x1 rasters, scaled up by trans() -- stand-
// ins so the demo needs nothing beyond what's already in the tree. Real
// photos come from import(path); JPEG/PNG/GIF import shells out to
// djpeg/pngtopnm/giftopnm (see OvImportCmd::Import), so those need to be
// on PATH. Swap the photocolors/raster() lines below for a loop of
// import() calls over a real photo directory to use real images -- the
// slot geometry and animation are unchanged either way, since both are
// just OverlayComp's manipulated by trans()/front().
//
// trans()'s tuple argument must be bare variables, not inline expressions,
// parenthesized sub-expressions, or function calls -- any of those make it
// silently fall back to its getter instead of setting (see the PR
// description). Every trans() call below stages its six values into plain
// variables first for exactly that reason.

CENTERX=427; CENTERY=550
BASEW=240; BASEH=160
FR=12
USEC=8000

offX0=(0-330); offX1=(0-180); offX2=0; offX3=180; offX4=330
sc0=0.42; sc1=0.65; sc2=1.0; sc3=0.65; sc4=0.42
lift0=40; lift1=20; lift2=0; lift3=20; lift4=40

// photo library: 7 solid-color stand-ins (see header for real photos)
photocolors=0xd94f4f,0xd9a54f,0xd9d24f,0x6fd94f,0x4fb8d9,0x6f4fd9,0xd94fbb
n=size(photocolors)
c0=at(photocolors 0)
imgs=raster(0,0,1,1 :rgb 1,1, c0)
for(i=1 i<n i=i+1
  ci=at(photocolors i);
  imgs=imgs,raster(0,0,1,1 :rgb 1,1, ci))
print("carousel: built %v photos\n" n)

// slotw/sloth/slotcx/slotcy(j) -- the (w,h,centerx,centery) a photo takes
// on when it sits in slot j (0=leftmost/farthest .. 4=rightmost/farthest,
// 2=center/frontmost)
slotw=func(
  j=arg(0);
  s=if(j==0 :then sc0 :else if(j==1 :then sc1 :else if(j==2 :then sc2 :else if(j==3 :then sc3 :else sc4))));
  w=BASEW*s;
  w)
sloth=func(
  j=arg(0);
  s=if(j==0 :then sc0 :else if(j==1 :then sc1 :else if(j==2 :then sc2 :else if(j==3 :then sc3 :else sc4))));
  h=BASEH*s;
  h)
slotcx=func(
  j=arg(0);
  o=if(j==0 :then offX0 :else if(j==1 :then offX1 :else if(j==2 :then offX2 :else if(j==3 :then offX3 :else offX4))));
  cx=CENTERX+o;
  cx)
slotcy=func(
  j=arg(0);
  l=if(j==0 :then lift0 :else if(j==1 :then lift1 :else if(j==2 :then lift2 :else if(j==3 :then lift3 :else lift4))));
  cy=CENTERY-l;
  cy)

// place(img j) -- move img to slot j's position/scale, absolute (trans :set)
place=func(
  img=arg(0); j=arg(1);
  w=slotw(j); h=sloth(j); cx=slotcx(j); cy=slotcy(j);
  hw=w/2; hh=h/2;
  tx=cx-hw; ty=cy-hh;
  trans(img w,0,0,h,tx,ty :set);
  nil)

// deck: which library photo (by index) currently occupies each of the 5
// slots; nextlib: the next library photo to spin in when advancing
d0=0; d1=1; d2=2; d3=3; d4=4
nextlib=5

img0=at(imgs d0); img1=at(imgs d1); img2=at(imgs d2); img3=at(imgs d3); img4=at(imgs d4)
place(img0 0); place(img1 1); place(img2 2); place(img3 3); place(img4 4)
front(img0); front(img4); front(img1); front(img3); front(img2)
print("carousel: initial deck %v %v %v %v %v\n" d0 d1 d2 d3 d4)

// fixed endpoints for the exit (past slot 0, off to the left) and entrance
// (from further right/back than slot 4) legs of the animation -- computed
// once since they never depend on which photo occupies the slot
exfromw=slotw(0); exfromh=sloth(0); exfromcx=slotcx(0); exfromcy=slotcy(0)
extow=42; extoh=28; extocx=(0-480); extocy=CENTERY-60
enfromw=25; enfromh=17; enfromcx=480; enfromcy=CENTERY-60
entow=slotw(4); entoh=sloth(4); entocx=slotcx(4); entocy=slotcy(4)
