// rast.comt -- a sliding row-window over a packed string(w*h UIntType)
// raster, for building kernel filters (blur, sharpen, edge detection)
// without materializing the whole window up front.
//
// rast.sldwin holds only the rows a kernel of height :kernszl@1 actually
// needs around the row currently being processed; rast.origin is the
// index of that row within rast.kernel. Near the top/bottom edge the kernel
// is simply shorter (2 rows instead of 3, 3 instead of 5, ...) rather
// than padded with nils -- the column direction gets edge handling for
// free from a plain @ index (a string @ past its length is nil, same
// as a stream past its end), but the row direction is bulk-loaded a
// whole row at a time, so it tracks its own shrink/grow state instead.
//
// Call rast.advance() once per output row, in row order starting at 0;
// each call returns the row it just centered on and updates
// rast.sldwin/rast.origin/rast.row to match. See src/comdraw/examples/README.md.

rast=(
  :w 16
  :h 12
  :kernszx 3
  :kernszy 3
  :in string(w*h UIntType)
  :out string(w*h UIntType)
  :sldwin list
  :krnorig 0
  :curx 0
  :cury 0
  :krn nil

  :paint func(
    for(temp(x)=0 x<w x++
      for(temp(y)=0 y<h y++
        in@(y*w+x)=x*100+y))
  )

  :advance func(

    print("ADVANCE"); 
    temp(half)=kernszy/2;
    if(size(sldwin)==0 :then
      for(temp(p)=0 p<=half p++ sldwin,in@(w*p):(w*(p+1)));
      krnorig=0;
      cury=0;
      print(" %d\n" 0);
      return(0)
    )

    if(cury<half :then
      cury=cury+1;
      rowoff=size(sldwin);
      sldwin,in@(w*rowoff):(w*(rowoff+1));
      krnorig++;
      print(" %d\n" cury);
      return(cury)
    )

    if (cury+half>=h-1 :then
      cury=cury+1;
      at(sldwin 0 :del);
      print(" %d\n" cury);
      return(cury)
    )

    // full row window, time to remove the front and add to back
    cury=cury+1;
    at(sldwin 0 :del);
    sldwin,in@(w*(cury+half)):(w*(cury+half+1));
    print(" %d\n" cury);
    return(cury)

  )

  :getker func(
    sldwin@(krnorig+arg(1))@(curx+arg(0))
  )
  
  :kern func(
    // krn is a receiver field; reuse its string across calls.
    if(krn==nil :then
      krn=string(kernszx*kernszy AnyType));
    temp(ki)=0;
    temp(halfx)=kernszx>>1;
    temp(evenx)=cond(halfx*2==kernszx 1 0);
    temp(halfy)=kernszy>>1;
    temp(eveny)=cond(halfy*2==kernszy 1 0);
    for(temp(j)=-halfy j<=halfy-eveny j++
      for(temp(i)=-halfx i<=halfx-evenx i++
        temp(k)=getker(i j);
        krn@(ki++)=k));
    krn)

  :smooth func(
    temp(summ)=0L;
    temp(cnt)=0;
    for(temp(i)=0 i<size(krn) i++
      temp(k)=krn@i;
      if(k!= nil :then cnt++;summ+=k));
    return(summ/cnt)
  )

  :smoothxy func(
    temp(x)=arg(0);temp(y)=arg(1);
    if(y>cury :then while(cury<y advance()));
    curx=x;
    kern();
    smooth()
  )

  :runrow func(
    temp(y) = advance();
    temp(yoff) = y*w;
    for(temp(x)=0 x<w x++ out@(yoff+x)=smoothxy(x y))
  )

  :runimg func(
    for(temp(y)=0 y<h y++ runrow())
  )

)

rast.paint()
s=rast.runimg()


