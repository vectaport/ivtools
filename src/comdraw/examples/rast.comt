// rast.comt -- a sliding row-window over a packed string(w*h UIntType)
// raster, for building kernel filters (blur, sharpen, edge detection)
// without materializing the whole window up front.
//
// rast.window holds only the rows a kernel of height :kernel@1 actually
// needs around the row currently being processed; rast.origin is the
// index of that row within rast.window. Near the top/bottom edge the window
// is simply shorter (2 rows instead of 3, 3 instead of 5, ...) rather
// than padded with nils -- the column direction gets edge handling for
// free from a plain @ index (a string @ past its length is nil, same
// as a stream past its end), but the row direction is bulk-loaded a
// whole row at a time, so it tracks its own shrink/grow state instead.
//
// Call rast.advance() once per output row, in row order starting at 0;
// each call returns the row it just centered on and updates
// rast.window/rast.origin/rast.row to match. See src/comdraw/examples/README.md.

rast=(
  :w 16
  :h 12
  :kernel 3,3
  :input string(w*h UIntType)
  :output string(w*h UIntType)
  :window list
  :row 0
  :origin 0

  :paint func(
    input@0..(w*h-1)=0..(w*h-1)
  )

  :advance func(

    y=1;
    half=kernel@y/2;
    if(size(window)==0 :then
      for(p=0 p<=half p++ window,input@(w*p):(w*(p+1)));
      origin=0;
      return(0)
    )
    if(row<half :then
      row=row+1;
      rowoff=size(window);
      window,input@(w*rowoff):(w*(rowoff+1));
      origin++;
      return(row)
    )

    if (row+half>=h-1 :then
      row=row+1;
      at(window 0 :del);
      return(row)
    )

    // full row window, time to remove the front and add to back
    row=row+1;
    at(window 0 :del);
    window,input@(w*(row+half)):(w*(row+half+1));
    return(row)


  )

)

rast.paint();
i=0;
while(i<rast.h
  r=rast.advance();
  print("row %d: window holds %d row(s), centered at window@%d\n" r size(rast.window) rast.origin);
  i=i+1
)
