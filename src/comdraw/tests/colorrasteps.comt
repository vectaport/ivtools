// src/comdraw/tests/colorrasteps.comt -- #518/#519: a grouped raster and a
// following graphic both round-trip correctly through idraw-format
// PostScript.
//
// Originally written for #519 alone: IdrawCatalog::PSReadChildren and
// OverlayCatalog::PSReadChildren both recognized the ColorRast tag (the
// real, full-color raster export writes) but, before that fix, never
// consumed its body when declining it -- the reader resumed mid-object,
// misread a stray token as the next sibling's tag, and (in OverlayCatalog)
// aborted the whole read right there, silently dropping every graphic
// after the raster in the file. #518 then gave OverlayCatalog real
// ColorRast-build support (ReadColorRast, ovcatalog.c) and made the
// corrected colorimage code the only raster writer (ovraster.c), so this
// now checks the stronger, real thing: the raster itself comes back
// pixel-correct, not just that its declined-and-skipped neighbor survives.
//
// export()'s idraw_format() split no longer affects the raster writer or
// the %%Creator: banner (both fixed by #518), so :idraw and :eps produce
// identical PostScript for this test's purposes, and import()'s own
// Creator-based file-type sniffing routes straight to the real catalog
// reader with no workaround needed.
//
// funcs: raster() rect() select() group() export() import() gets() print()

ok=true
each(delete($$select(:all)))

// /tmp, not repo-relative -- see rastereps.comt for why.
srand(int(time(:raw)))
suffix=int(rand(0,999999))
epspath=print("/tmp/ivtools-colorrasteps-%d.eps" suffix :str)

// --- test 1: group a raster with a rect, and export -- confirm the file
//             has a ColorRast object before a Rect *object* (not the
//             prolog's own "/Rect {" procedure definition), or the rest
//             of this test proves nothing ---
ra=raster(0,0,64,64 :rgb 2,2,
  0xff0000,0x00ff00,
  0x0000ff,0xffffff)
rt=rect(200,200,300,260)
select(ra rt)
g=group()
ok=ok&&(size(g)==2)
export(g epspath :idraw)

fp=open(epspath "r")
sawColorRast=false
sawRect=false
sawColorRastFirst=false
while((ln=gets(fp))!=nil
  if(index(ln "Begin" :substr)==0&&index(ln "ColorRast" :substr)!=nil&&!sawColorRast :then sawColorRast=true);
  if(index(ln "Begin" :substr)==0&&index(ln "Rect" :substr)!=nil&&!sawRect :then sawRect=true;sawColorRastFirst=sawColorRast))
close(fp)
ok=ok&&sawColorRast&&sawRect&&sawColorRastFirst
print("1 exported file has a ColorRast object before a Rect object (expect true): %v\n" (sawColorRast&&sawRect&&sawColorRastFirst))

// --- test 2: re-importing recovers BOTH graphics correctly -- the raster
//             with its original pixel colors, and the rect (after it in
//             the file) with its original coordinates.  export(:percomp)
//             walks the real GraphicComp tree directly, so this doesn't
//             depend on the view-realization timing children() needs. ---
each(delete($$select(:all)))
page=import(epspath)
ok=ok&&(page!=nil)
e=export(page :string :percomp)
sawRasterColors=(index(e "(255,0,0)")!=nil)&&(index(e "(0,255,0)")!=nil)&&(index(e "(0,0,255)")!=nil)&&(index(e "(255,255,255)")!=nil)
sawRectCoords=(index(e "200,200,300,260")!=nil)
ok=ok&&sawRasterColors&&sawRectCoords
print("2a raster recovers all four original pixel colors (expect true): %v\n" sawRasterColors)
print("2b rect keeps its original coordinates after the raster (expect true): %v\n" sawRectCoords)
print("2c reconstructed picture: %v\n" e)

print("colorrasteps: %v\n" ok)
ok
