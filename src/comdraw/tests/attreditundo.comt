// src/comdraw/tests/attreditundo.comt -- the attribute dialog's edit is a command
//
// OverlayKit::apply_attr_edit() is the half of AttributeDialogImpl::accept()
// that survives without the widget: it builds a SetAttrCmd through the kit's
// factory, sets replace() so the list it carries is the component's whole new
// property list rather than an addition to it, and executes it.  attredit_test()
// calls it with a synthetic list, standing in for two typed fields and a press
// of Apply.  What that buys over setattr() is the two behaviors only the dialog
// has: replace (a key removed in the dialog goes away) and an undo step that
// restores the whole prior list rather than the keys just written.
//
// The widget itself stays manual -- no XTest under xvfb.  See
// src/comdraw/tests/TESTING.md, "What Belongs Here".
//
// funcs: attredit_test undo redo undoable setattr dot-read help index

ok=true
each(delete($$select(:all)))

r=rect(50,50,150,150)

// --- test 1: an edit through the kit sets the whole list ---
attredit_test(r :hp 7 :ac 15)
ok=ok&&(r.hp==7)&&(r.ac==15)
print("1 attredit_test(r :hp 7 :ac 15); r.hp r.ac (expect 7 15): %v %v\n" r.hp r.ac)

// --- test 2: replace -- a key left out of the new list goes away ---
// setattr() merges, so this is the one semantic the dialog alone needs.
attredit_test(r :hp 9)
ok=ok&&(r.hp==9)&&(r.ac==nil)
print("2 attredit_test(r :hp 9) drops the unlisted ac (expect 9 nil): %v %v\n" r.hp r.ac)

// --- test 3: undo restores the whole prior list, ac included ---
undo()
ok=ok&&(r.hp==7)&&(r.ac==15)
print("3 undo(); r.hp r.ac restored together (expect 7 15): %v %v\n" r.hp r.ac)

// --- test 4: redo reapplies the replace ---
redo()
ok=ok&&(r.hp==9)&&(r.ac==nil)
print("4 redo(); r.hp r.ac (expect 9 nil): %v %v\n" r.hp r.ac)

// --- test 5: undoing back past the first edit leaves no attribute ---
undo()
undo()
ok=ok&&(r.hp==nil)&&(r.ac==nil)
print("5 undo() back past the first edit; r.hp r.ac (expect nil nil): %v %v\n" r.hp r.ac)

// --- test 6: one call is one undo step however many keywords it wrote ---
// test 1 wrote two keywords; the redo that puts them back is a single step,
// so the depth undoable() reports moves by one.
before=undoable()
redo()
ok=ok&&(r.hp==7)&&(r.ac==15)&&(undoable()==before+1)
print("6 redo() of a two-keyword edit is one step; r.hp r.ac undoable()-before (expect 7 15 1): %v %v %v\n" r.hp r.ac undoable()-before)

// --- test 7: one component's undo leaves another's attributes alone ---
e=rect(300,300,400,400)
attredit_test(e :hp 99)
attredit_test(r :hp 1)
undo()
ok=ok&&(r.hp==7)&&(r.ac==15)&&(e.hp==99)
print("7 undo() of the edit to r; r.hp r.ac e.hp (expect 7 15 99): %v %v %v\n" r.hp r.ac e.hp)

// --- test 8: setattr() still merges, and is still not undoable ---
// PR 1 leaves the scripted path alone: setattr() writes the list directly,
// so it adds to what the dialog's edit left and contributes no undo step.
pre8=undoable()
setattr(r :speed 30)
ok=ok&&(r.speed==30)&&(r.hp==7)&&(undoable()==pre8)
print("8 setattr(r :speed 30) merges and logs nothing; r.speed r.hp undoable()-pre8 (expect 30 7 0): %v %v %v\n" r.speed r.hp undoable()-pre8)

// --- test 9: attredit_test stays out of help()'s listing ---
// TEST-ONLY commands are registered hidden (ComFunc::hidden()) so they don't
// clutter help() for driving-script authors, while staying fully callable.
ok=ok&&(index(help() "attredit_test" :substr)==nil)
print("9 attredit_test absent from help()'s listing (expect nil): %v\n" index(help() "attredit_test" :substr))

print("attreditundo: %v\n" ok)
ok
