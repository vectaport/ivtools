  :else print("FAIL: export_cutoff\n");topok=false)

if(run("./quarterpusher.comt")
  :then print("pass: quarterpusher\n")
  :else print("FAIL: quarterpusher\n");topok=false)

print("\nrun_all: %v\n" topok)
