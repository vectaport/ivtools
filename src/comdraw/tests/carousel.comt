// src/comdraw/tests/carousel.comt -- integration coverage for the
// examples/carousel.comt coverflow demo: front slot is largest and
// centered, side slots shrink symmetrically, and advancing (carousel.next())
// or reversing (carousel.prev()) rotates the deck while every slot
// converges back to the same target geometry regardless of which photo
// now occupies it.
//
// funcs: carousel.next carousel.prev carousel.zoomin carousel.zoomout place park slotw sloth slotcx slotcy
run("../examples/carousel.comt")

ok=true

// --- test 1: the library and initial deck are the sizes examples/carousel.comt promises ---
ok=ok&&(n==7)
ok=ok&&(size(imgs)==7)
print("1 size(imgs) (expect 7): %v\n" size(imgs))

// tuplesclose(a b) -- true when two 6-element trans() tuples match within
// a fraction of a pixel (see test 2's note on float rounding)
tuplesclose=func(
  ta=arg(0); tb=arg(1);
  d0=abs(at(ta 0)-at(tb 0)); d1=abs(at(ta 1)-at(tb 1)); d2=abs(at(ta 2)-at(tb 2));
  d3=abs(at(ta 3)-at(tb 3)); d4=abs(at(ta 4)-at(tb 4)); d5=abs(at(ta 5)-at(tb 5));
  (d0<0.01)&&(d1<0.01)&&(d2<0.01)&&(d3<0.01)&&(d4<0.01)&&(d5<0.01))

// --- test 1b: the two library photos not in the initial 5-slot deck (5,6)
//              are parked at the entrance-staging spot, not left at
//              whatever position import() happened to paste them ---
pw5=at(libw 5); ph5=at(libh 5); pw6=at(libw 6); ph6=at(libh 6)
parktrans=func(
  pw=arg(0); ph=arg(1);
  sx=enfromw/pw; sy=enfromh/ph; tx=enfromcx-enfromw/2; ty=enfromcy-enfromh/2;
  sx,0,0,sy,tx,ty)
t5=trans(at(imgs 5)); t6=trans(at(imgs 6))
ok=ok&&tuplesclose(t5 parktrans(pw5 ph5))&&tuplesclose(t6 parktrans(pw6 ph6))
print("1b photos 5,6 parked off-canvas (expect %v %v): %v %v\n" parktrans(pw5 ph5) parktrans(pw6 ph6) t5 t6)

// --- test 2: front slot (2) is centered and largest; side slots shrink
//             symmetrically outward, matching sc0..sc4/offX0..offX4.
//             mbr() coordinates are floats with a little rounding noise
//             from the screen/drawing conversion (different absolute
//             positions round differently even at the same scale), so
//             sizes are compared within a fraction-of-a-pixel tolerance
//             rather than by exact equality. ---
m0=mbr(carousel.img0); m1=mbr(carousel.img1); m2=mbr(carousel.img2); m3=mbr(carousel.img3); m4=mbr(carousel.img4)
w0=at(m0 2)-at(m0 0); w2=at(m2 2)-at(m2 0); w4=at(m4 2)-at(m4 0)
wdiff=abs(w0-w4)
ok=ok&&(w2>w0)&&(wdiff<0.01)
print("2 front slot is widest, sides match (w0,w2,w4): %v,%v,%v\n" w0 w2 w4)

cx0=(at(m0 0)+at(m0 2))/2; cx2=(at(m2 0)+at(m2 2))/2; cx4=(at(m4 0)+at(m4 2))/2
ok=ok&&(cx0<cx2)&&(cx2<cx4)
print("2b slots run left to right (cx0,cx2,cx4): %v,%v,%v\n" cx0 cx2 cx4)

// mbrsclose(a b) -- true when two mbr() results match within a fraction
// of a pixel (see test 2's note on float rounding)
mbrsclose=func(
  mbra=arg(0); mbrb=arg(1);
  diff0=abs(at(mbra 0)-at(mbrb 0)); diff1=abs(at(mbra 1)-at(mbrb 1));
  diff2=abs(at(mbra 2)-at(mbrb 2)); diff3=abs(at(mbra 3)-at(mbrb 3));
  nearmatch=(diff0<0.01)&&(diff1<0.01)&&(diff2<0.01)&&(diff3<0.01);
  nearmatch)

// --- test 3: advancing rotates the deck: each slot's photo index shifts
//             down by one, and a fresh library photo appears at slot 4 ---
carousel.next()
ok=ok&&(carousel.d0==1)&&(carousel.d1==2)&&(carousel.d2==3)&&(carousel.d3==4)&&(carousel.d4==5)&&(carousel.nextlib==6)
print("3 deck after one advance (expect 1 2 3 4 5, nextlib 6): %v %v %v %v %v nextlib=%v\n" carousel.d0 carousel.d1 carousel.d2 carousel.d3 carousel.d4 carousel.nextlib)

// --- test 4: whichever photo now sits in a slot, its geometry matches that
//             slot's fixed target -- the animation converges, not just the
//             bookkeeping ---
ok=ok&&mbrsclose(mbr(carousel.img2) m2)
print("4 the new front photo lands on the same front-slot geometry (expect %v): %v\n" m2 mbr(carousel.img2))

// --- test 5: advancing past the end of the 7-photo library wraps around
//             instead of erroring ---
carousel.next()
carousel.next()
carousel.next()
carousel.next()
carousel.next()
ok=ok&&(carousel.nextlib==4)
ok=ok&&mbrsclose(mbr(carousel.img2) m2)
print("5 six advances total wrap the 7-photo library (expect nextlib 4): %v\n" carousel.nextlib)

// --- test 6: prev() is next()'s exact mirror -- one prev() undoes the
//             sixth advance, landing back on the deck test 5 passed
//             through (5,6,0,1,2 nextlib 3), with the same converged
//             front-slot geometry ---
carousel.prev()
ok=ok&&(carousel.d0==5)&&(carousel.d1==6)&&(carousel.d2==0)&&(carousel.d3==1)&&(carousel.d4==2)&&(carousel.nextlib==3)
ok=ok&&mbrsclose(mbr(carousel.img2) m2)
print("6 prev() undoes an advance (expect 5 6 0 1 2, nextlib 3): %v %v %v %v %v nextlib=%v\n" carousel.d0 carousel.d1 carousel.d2 carousel.d3 carousel.d4 carousel.nextlib)

// --- test 7: zoomin() grows the center photo to fill the canvas, and
//             zoomout() is its exact mirror; repeating either while
//             already in that state is a no-op (full doesn't toggle
//             or drift on a redundant call) ---
h2=at(m2 3)-at(m2 1)
m2_before_zoom=mbr(carousel.img2)
carousel.zoomin()
ok=ok&&(carousel.full==1)
m2_full=mbr(carousel.img2)
w_full=at(m2_full 2)-at(m2_full 0); h_full=at(m2_full 3)-at(m2_full 1)
ok=ok&&(w_full>w2)&&(h_full>h2)
print("7 zoomin() grows the center photo (expect wider/taller than %v,%v): %v,%v\n" w2 h2 w_full h_full)
carousel.zoomin()
ok=ok&&(carousel.full==1)&&mbrsclose(mbr(carousel.img2) m2_full)
print("7b redundant zoomin() is a no-op (expect full=1, same geometry): full=%v\n" carousel.full)
carousel.zoomout()
ok=ok&&(carousel.full==0)&&mbrsclose(mbr(carousel.img2) m2_before_zoom)
print("7c zoomout() exactly reverses zoomin() (expect %v): %v\n" m2_before_zoom mbr(carousel.img2))
carousel.zoomout()
ok=ok&&(carousel.full==0)&&mbrsclose(mbr(carousel.img2) m2_before_zoom)
print("7d redundant zoomout() is a no-op (expect full=0, same geometry): full=%v\n" carousel.full)

print("carousel: %v\n" ok)
ok
