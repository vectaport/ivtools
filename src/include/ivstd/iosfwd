#ifndef _iv_iosfwd_
#define _iv_iosfwd_
#if __GNUC__>=3
#include_next <iosfwd>
using std::ios_base;
using std::filebuf;
using std::istream;
using std::ostream;
#define out_form(ostr,format,value) \
{ \
char buffer[1024]; \
int _out_form_n = snprintf(buffer, 1024, format, value); \
if (_out_form_n < (int)sizeof(buffer)) { \
  ostr << buffer; \
} else { \
  char* _out_form_big = new char[_out_form_n+1]; \
  snprintf(_out_form_big, _out_form_n+1, format, value); \
  ostr << _out_form_big; \
  delete[] _out_form_big; \
} \
}
#else
class istream;
class ostream;
#define out_form(ostr,format,value) \
ostr.form(format,value);
#endif
#endif
