// src/comterp_/tests/runfile.comt -- test run() on a file whose last
// top-level expression is left incomplete at end-of-file, and the
// opposite case: a file whose last line is a comment or blank
//
// A trailing ";" at true EOF with nothing after it is itself an
// incomplete expression (";" separates expressions, it doesn't
// terminate them), so run() should report the error and return nil
// rather than crash or corrupt parser state for whatever runs next.
//
// A file that ends on a comment or a blank line is the opposite case:
// nothing is incomplete, so run() should return the last real value
// and print nothing, the same as if the file had ended right after
// that value.
//
// Run from inside comterp, comdraw, or drawserv:
//   run("src/comterp_/tests/runfile.comt")

run("./testlib.comt")
ok=true

// --- test 1: incomplete expr, file ends with a newline after the ";" ---
val=run("./runfile_sub_incomplete_eol.comt")
ok=ok&&(val==nil)
print("1 run() on \"1;\\n\" (trailing newline) returns nil (expect nil): %v\n\n" val)
check_fail(:ok ok)

// --- test 2: incomplete expr, file has no trailing newline at all ---
val=run("./runfile_sub_incomplete_noeol.comt")
ok=ok&&(val==nil)
print("2 run() on \"1;\" (no trailing newline) returns nil (expect nil): %v\n\n" val)
check_fail(:ok ok)

// --- test 3: interpreter survives both failed runs uncorrupted ---
v=1+1
ok=ok&&(v==2)
print("3 interpreter still functional after failed run()s (expect 2): %v\n\n" v)
check_fail(:ok ok)

// --- test 4: a file ending on a comment-only line is not incomplete --
// spawn a subprocess (see string.comt's :tokval/:tokstr tests) since
// comterp can't inspect its own stderr, and the return value alone
// doesn't prove the diagnostic wasn't also printed on the way there ---
val4=run("./runfile_sub_trailing_comment.comt")
out4=*$$open("comterp \"run(\\\"./runfile_sub_trailing_comment.comt\\\")\" 2>&1 | tr \"\\n\" \" \"" :pipe)
warned4=index(out4 "Unexpected end-of-file" :substr)
ok=ok&&(val4==1)&&(warned4==nil)
print("4 run() on \"x=1\\n// trailing comment\\n\" returns 1 with no stderr diagnostic (expect 1 nil): %v %v\n\n" val4 warned4)
check_fail(:ok ok)

// --- test 5: a file ending on a blank line is not incomplete either ---
val5=run("./runfile_sub_trailing_blank.comt")
out5=*$$open("comterp \"run(\\\"./runfile_sub_trailing_blank.comt\\\")\" 2>&1 | tr \"\\n\" \" \"" :pipe)
warned5=index(out5 "Unexpected end-of-file" :substr)
ok=ok&&(val5==1)&&(warned5==nil)
print("5 run() on \"x=1\\n\\n\" returns 1 with no stderr diagnostic (expect 1 nil): %v %v\n\n" val5 warned5)
check_fail(:ok ok)

// --- test 6: two top-level statements joined by a bare space on the
// file's last line used to silently drop the second one -- runfile()
// read one physical line per read_expr() call and always fetched a new
// line next time, even when the parser's own buffer still held an
// unconsumed second statement.  Both assignments have to take, not just
// the file's return value, since the return value alone (whatever the
// last statement evaluates to) can't distinguish "ran" from "never ran"
// the way a fresh variable can ---
joined_a=99
joined_b=99
run("./runfile_sub_joined_last.comt")
ok=ok&&(joined_a==1)&&(joined_b==2)
print("6 \"x=1 y=2\" as a file's last line runs both (expect 1 2): %v %v\n\n" joined_a joined_b)
check_fail(:ok ok)

// --- test 7: the same bug's other shape -- when something follows the
// joined line, the joined pair both ran, but the *next* statement was
// the one silently dropped (the parser was still consuming the joined
// line's leftover instead of the following line's freshly-loaded text) ---
joined_c=99
joined_d=99
joined_e=99
run("./runfile_sub_joined_mid.comt")
ok=ok&&(joined_c==1)&&(joined_d==2)&&(joined_e==3)
print("7 a joined line plus a following statement all run (expect 1 2 3): %v %v %v\n\n" joined_c joined_d joined_e)
check_fail(:ok ok)

// --- test 8: a file's last statement can be a stream, trailing
// newline and all -- istype() checks the shape without draining it,
// the way at()/print() would ---
val8=run("./runfile_sub_trailing_stream.comt")
isstrm8=istype(val8 StreamType)
ok=ok&&isstrm8
print("8 run() preserves a trailing bare stream (expect true): %v\n\n" isstrm8)
check_fail(:ok ok)

// --- test 9: `comterp run <file>` on an orphaned stream shows its
// drained count in brackets ("[5]"), the same wrapper the interactive
// prompt already used -- spawn a subprocess since the CLI dispatch in
// main.c isn't reachable from inside a running interpreter.  tr folds
// the trailing newline to a space, per the same convention used above ---
out9=*$$open("comterp run ./runfile_sub_bare_stream.comt 2>/dev/null | tr \"\\n\" \" \"" :pipe)
ok=ok&&(out9=="[5] ")
print("9 \"comterp run <file>\" on an orphaned stream brackets its count (expect [5]): %v\n\n" out9)
check_fail(:ok ok)

// --- test 10: the one-shot `comterp '<expr>'` CLI form gets the same
// bracketed count ---
out10=*$$open("comterp '0..4' 2>/dev/null | tr \"\\n\" \" \"" :pipe)
ok=ok&&(out10=="[5] ")
print("10 \"comterp '<expr>'\" on an orphaned stream brackets its count (expect [5]): %v\n\n" out10)
check_fail(:ok ok)

print("\nrunfile: %v\n" ok)
ok
