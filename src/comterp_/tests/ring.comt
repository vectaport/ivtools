// src/comterp_/tests/ring.comt -- ring(), shorthand for feed(string())
//
// coverage: 6/7 (86%)
// funcs: ring
// missing: ring(stress) ring(random)
//
// ring(cap [typesym]) builds a fixed-capacity ring FIFO directly,
// without spelling out the backing string -- ring(cap) is
// feed(string(cap)), ring(cap typesym) is feed(string(cap typesym)).
// For a non-wrapping ring, use feed(string(cap [typesym]) :noring)
// directly -- ring() doesn't forward that keyword.  See feedring.comt
// for the ring behavior itself (push/pop/wrap/typed slots/traffic
// counter); this script only covers ring() being the same construction
// as feed(string()), not re-testing the ring mechanics.

ok=true

// --- 1: existence, basic arity -- ring(cap) ---
r1=ring(4)
ok=ok&&(istype(r1 StreamType))
print("1 istype(ring(4) StreamType) (expect true): %v\n" istype(r1 StreamType))

// --- 2: push/pop round trip ---
feed(r1 'a')
c2=next(r1)
ok=ok&&(c2=='a')
print("2 feed(ring(4) 'a');next (expect 'a'): %v\n" c2)

// --- 3: 2-arity -- ring(cap typesym) sizes in elements, same as
// feed(string(cap typesym)) ---
r3=ring(4 UIntType)
i3=info(r3)
ok=ok&&(i3.cap==4)&&(i3.count==0)
print("3 info(ring(4 UIntType)) (expect cap 4, count 0): %v %v\n" i3.cap i3.count)

// --- 4: ring(cap) and feed(string(cap)) build the same thing --
// identical info() apart from :base, and the same print-traffic behavior ---
rA=ring(8 AnyType)
rB=feed(string(8 AnyType))
feed(rA 'x' 'y' 'z')
feed(rB 'x' 'y' 'z')
al4=(:a nil :b nil)
al4.a=rA
al4.b=rB
out4=print("%v" al4 :str)
ok=ok&&(out4=="(:a [3] :b [3])")
print("4 ring(8 AnyType) and feed(string(8 AnyType)) print the same traffic (expect (:a [3] :b [3])): %v\n" out4)

// --- 5: return type -- a fresh ring is a StreamType, same as feed(string()) ---
ok=ok&&(type(ring(2))==`StreamType)
print("5 type(ring(2)) (expect StreamType): %v\n" type(ring(2)))

// --- 6: info()'s :blocksz/:blocktype report the ring's own element
// width/type, same fields and values info() on the backing string itself
// would give -- 0/UnknownType for an ordinary char-granular ring, the
// typed values for a typed one. ---
i6a=info(ring(3))
ok=ok&&(i6a.blocksz==0)&&(i6a.blocktype==`UnknownType)
print("6a info(ring(3)).blocksz/.blocktype (expect 0 UnknownType): %v %v\n" i6a.blocksz i6a.blocktype)
i6b=info(ring(4 UIntType))
ok=ok&&(i6b.blocksz==4)&&(i6b.blocktype==`UIntType)
print("6b info(ring(4 UIntType)).blocksz/.blocktype (expect 4 UIntType): %v %v\n" i6b.blocksz i6b.blocktype)

print("ring: %v\n" ok)
ok
