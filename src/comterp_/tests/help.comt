// src/comterp_/tests/help.comt -- test help() and optable()
//
// coverage: 21/21 (100%)
// funcs: help() help(:posteval) help(:top) help("op") help(cmd :key name)
//        optable(:table) optable(:bypri) optable(:byopr) optable(:bycom)
// optable(:table) returns list of attrlists (:opr :cmd :pri :rtol :type)
// optable(:bypri :byopr :bycom) prints to stdout only
//
// Run from inside comterp, comdraw, or drawserv:
//   run("src/comterp_/tests/help.comt")

run("./testlib.comt")
ok=true

// --- test 1: help(help) returns a string ---
h=help(help)
ok=ok&&(type(h)==`StringType)
print("1 help(help) returns StringType (expect StringType): %v\n" type(h))
prev_ok=check_fail(:ok ok)

// --- test 2: help(help) non-empty ---
ok=ok&&(size(h)>0)
print("2 help(help) non-empty (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 3: help of two commands returns longer string ---
h2=help(help print)
ok=ok&&(type(h2)==`StringType)
ok=ok&&(size(h2)>size(h))
print("3 help(help print) longer than help(help) (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 4: help(:posteval) returns non-empty string ---
hp=help(:posteval)
ok=ok&&(type(hp)==`StringType)
ok=ok&&(size(hp)>0)
print("4 help(:posteval) non-empty (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 5: help(:top) returns non-empty string ---
ht=help(:top)
ok=ok&&(type(ht)==`StringType)
ok=ok&&(size(ht)>0)
print("5 help(:top) non-empty (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 6: help("$$") returns non-empty string for operator given as string ---
hstrm=help("$$")
ok=ok&&(type(hstrm)==`StringType)
ok=ok&&(size(hstrm)>0)
print("6 help(\"$$\") non-empty string (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 6b: help(optable) mentions :table keyword ---
ho=help(optable)
ok=ok&&(type(ho)==`StringType)
ok=ok&&(size(ho)>0)
print("6b help(optable) mentions :table (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 7: optable(:table) returns a list ---
tbl=optable(:table)
ok=ok&&(type(tbl)==`ListType)
ok=ok&&(size(tbl)>0)
print("7 optable(:table) returns non-empty list (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 8: each entry is an attrlist with :opr :cmd :pri :rtol :type ---
al=at(tbl 0)
ok=ok&&(class(al)==`AttributeList)
ok=ok&&(al.opr!=nil)
ok=ok&&(al.cmd!=nil)
ok=ok&&(al.pri>0)
ok=ok&&(al.rtol!=nil)
ok=ok&&(al.type!=nil)
print("8 optable entry has :opr :cmd :pri :rtol :type (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 9: known entries present -- "+" cmd "add" pri 60 ---
found=false
for(i=0 i<size(tbl) i++
  if(at(tbl i).opr=="+" && at(tbl i).cmd=="add" :then found=true))
ok=ok&&found
print("9 optable has +:add:pri60 (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 10: "$$" entry is stream, rtol true, UNARY PREFIX ---
found=false
for(i=0 i<size(tbl) i++
  if(at(tbl i).opr=="$$" && at(tbl i).cmd=="stream" :then found=true))
ok=ok&&found
print("10 optable has $$:stream (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 11: optable(:bypri) no crash ---
optable(:bypri)
ok=ok&&true
print("11 optable(:bypri) no crash (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 12: optable(:byopr) no crash ---
optable(:byopr)
ok=ok&&true
print("12 optable(:byopr) no crash (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 13: optable(:bycom) no crash ---
optable(:bycom)
ok=ok&&true
print("13 optable(:bycom) no crash (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 14: help(cmd :key name) returns the dockeys() description ---
kd=help(help :key top)
ok=ok&&(type(kd)==`StringType)
ok=ok&&(kd=="return help on top-level commands specific to this program")
print("14 help(help :key top) returns its dockeys description (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 14b: alias-bearing dockeys entries are checked by every alias ---
kdopr=help(optable :key pri)
ok=ok&&(type(kdopr)==`StringType)
ok=ok&&(kdopr=="operator priority for :insert (default 80)")
print("14b help(optable :key pri) returns its own description, not a keyword\n   mentioned in another entry's free text (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 15: help(cmd :key name) returns true for a keyword declared in
//     the signature but with no separate dockeys() entry ---
kb=help(beep :key count)
ok=ok&&(kb==true)
print("15 help(beep :key count) returns true (expect true): %v\n" kb)
prev_ok=check_fail(:ok ok)

// --- test 16: help(cmd :key name) returns nil for an unrecognized keyword ---
ku=help(beep :key bogus123)
ok=ok&&(ku==nil)
print("16 help(beep :key bogus123) returns nil (expect true): %v\n" (ku==nil))
prev_ok=check_fail(:ok ok)

// --- test 17: help(cmd :key name) also resolves a name that is itself a
//     registered command (e.g. posteval), not just a bare symbol ---
kp=help(help :key posteval)
ok=ok&&(type(kp)==`StringType)
ok=ok&&(kp=="return help on commands that post evaluate arguments")
print("17 help(help :key posteval) resolves a command-shaped key name\n   (expect true): %v\n" ok)
prev_ok=check_fail(:ok ok)

// --- test 18: help(cmd :key name) also works when cmd is passed as a
//     quoted string naming a registered command (not just bare/symbol) ---
ks=help("beep" :key count)
ok=ok&&(ks==true)
print("18 help(\"beep\" :key count) returns true (expect true): %v\n" ks)
prev_ok=check_fail(:ok ok)

// --- test 19: a colon inside a signature's "[...]" positional-argument
//     group (date's year-led "YEAR:MON[:day]" form) is a value separator,
//     not a declared keyword, so :key must not mistake it for one ---
kv=help(date :key MON)
ok=ok&&(kv==nil)
print("19 help(date :key MON) returns nil (expect true): %v\n" (kv==nil))
prev_ok=check_fail(:ok ok)

// --- test 20: a keyword bracketed as optional in the signature (islist's
//     "[:any]", since every keyword is optional) is still a real keyword,
//     unlike a value-form colon glued onto a preceding identifier ---
ka=help(islist :key any)
ok=ok&&(ka==true)
print("20 help(islist :key any) returns true (expect true): %v\n" ka)
prev_ok=check_fail(:ok ok)

// --- test 21: a value-form field glued onto a ']' that closes a nested
//     value-form group with no space before its own '[' (time's
//     "[:ms:us:ns]:TZ") is still a value separator, not a keyword --
//     the real keyword is the differently-cased ":tz" later in the
//     signature, which :key must still find ---
kt=help(time :key TZ)
ok=ok&&(kt==nil)
print("21 help(time :key TZ) returns nil (expect true): %v\n" (kt==nil))
prev_ok=check_fail(:ok ok)
kz=help(time :key tz)
ok=ok&&(type(kz)==`StringType)
print("21b help(time :key tz) returns its dockeys description\n    (expect true): %v\n" (type(kz)==`StringType))
prev_ok=check_fail(:ok ok)

print("help: %v\n" ok)
ok
