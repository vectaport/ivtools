// info-obj.comt version 11
print("info-obj.comt version 11\n")

// src/comterp_/tests/info-obj.comt -- tests for info()'s dispatch on
// opaque Obj types other than streams: AttributeList, a bare func by
// name, FileObj, DateObj, and TimeObj.
//
// coverage:
//   test 1:  info(attrlst) -- (:sealed :count) on an ordinary attrlist
//   test 2:  info((f.)) -- a func's own sealed captures list, matching
//            the exact spec: f=func(a+b+c); info((f.)) == (:sealed true :count 3)
//   test 3:  info(f) on a bare func name -- (:ntoks :nspans :posteval),
//            and f itself is never called (no side effect fires)
//   test 3b: info(f).source reconstructs a func(params;body) definition's
//            compiled body as readable ComTerp source, one statement per
//            indented line; run()-ing that returned string back round-trips
//            to the same ntoks/nspans
//   test 3c: info(f).source on a keyword/global-assign body
//   test 3d: info(f).source respects cutoff() on a func with many bodies
//   test 3g: info(f).source indents a ';'-chain nested inside a keyword
//            value too, not just the top-level one
//   test 3h: info(f).source on a 3+ statement ';'-chain renders a flat
//            one-statement-per-line list, not a staircase of nested parens
//   test 3i: info(f).source on if(... :then ... :else ...) starts :else
//            and the closing paren on their own lines
//   test 3j: info(f).source on for(init test step body) starts body on
//            its own line
//   test 3k: info(f).source on while(test body) starts body on its own
//            line, same as for()'s
//   test 3l: for()'s and while()'s body each splice a ';'-chain bare,
//            not wrapped in parens that would reparse differently, with
//            every statement in the chain at the same indent
//   test 3m: if()'s keyword slots fall back to the generic renderer on
//            a non-keyword positional instead of misreading and crashing
//   test 3n: a :then/:else value that is itself an if() keeps its own
//            closing paren aligned with its own opening line
//   test 3e: info(a.f) finds the FuncObj behind a dot expression without
//            firing it; a non-func dotted field falls through to the
//            ordinary dispatch on its own value
//   test 3f: info(a.b.f) follows a nested dot chain
//   test 4:  info(f) with :posteval true reports it
//   test 5:  info(fileobj) -- (:filename :mode :open), and :open flips
//            to false after close()
//   test 6:  info(dateobj) -- a live year:mon:day colon list that
//            round-trips through date(), unlike its printOn() text
//   test 7:  info(timeobj) -- a live colon list round-tripping through
//            time() for a dateless instant and for a duration alike
//   test 8:  info(sockobj) -- (:host :port) against a real comterp server
//   test 9:  info(lst) -- (:count :coloned :nested :cutoff) on a plain list,
//            default values plus :nested/:cutoff away from their defaults
//
// PipeObj is deliberately NOT exercised here -- constructing a real
// bidirectional pipe (open(cmd "rw" :pipe), which forks via popen2())
// corrupts state that later crashes an unrelated test elsewhere in this
// suite, reproducibly, with nothing else involved (issue #634). info()'s
// own PipeObj dispatch in strmfunc.c is untouched by that bug and was
// verified manually against a real PipeObj outside the suite.
//
// Run from inside comterp, comdraw, or drawserv:
//   run("src/comterp_/tests/info-obj.comt")

errmsg(:clear)
run("./testlib.comt")
ok=true

// --- test 1: info(attrlst) reports :sealed and :count ---
errmsg(:clear)
al1=attrlist(:x 1 :y 2 :z 3)
i1=info(al1)
ok1=(i1.sealed==false)&&(i1.count==3)
ok=ok&&ok1
print("1 info(attrlist(:x 1 :y 2 :z 3)) (expect sealed false, count 3): %v\n" ok1)
prev_ok=check_fail(:ok ok)

// --- test 2: info((f.)) on a func's own sealed captures list ---
errmsg(:clear)
f2=func(a+b+c)
i2=info((f2.))
ok2=(i2.sealed==true)&&(i2.count==3)
ok=ok&&ok2
print("2 f2=func(a+b+c); info((f2.)) (expect sealed true, count 3): %v\n" ok2)
prev_ok=check_fail(:ok ok)

// --- test 3: info(f) on a bare func name never fires f ---
errmsg(:clear)
sideeffect=0
f3=func(sideeffect=sideeffect+1; sideeffect)
i3=info(f3)
ok3=(class(i3)==`AttributeList)&&(i3.ntoks>0)&&(sideeffect==0)
ok=ok&&ok3
print("3 info(f3) on a bare func name -- class AttributeList, ntoks>0, f3 never called (expect true): %v\n" ok3)
prev_ok=check_fail(:ok ok)

// --- test 3b: info(f).source reconstructs func(a b;a+b*2)'s compiled
// body, and PARSING THAT RETURNED STRING back (not a separately
// hand-written expression) reparses to the same ntoks/nspans ---
errmsg(:clear)
f3b=func(a b;a+b*2)
i3b=info(f3b)
g3b=run(i3b.source :str)
ig3b=info(g3b)
ok3b=(i3b.source=="func(\n  a\n  b;\n  add(a mpy(b 2))\n)")&&(ig3b.ntoks==i3b.ntoks)&&(ig3b.nspans==i3b.nspans)
ok=ok&&ok3b
print("3b f3b=func(a b;a+b*2); info(f3b).source, one statement per line: %v\n" i3b.source)
prev_ok=check_fail(:ok ok)

// --- test 3c: info(f).source on a keyword/global-assign body, proving
// the keyword-tuple and assign-infix rendering paths both round-trip ---
errmsg(:clear)
f3c=func(x;global(y)=x*2)
i3c=info(f3c)
ok3c=(i3c.source=="func(\n  x;\n  global(y)=mpy(x 2)\n)")
ok=ok&&ok3c
print("3c f3c=func(x;global(y)=x*2); info(f3c).source, one statement per line: %v\n" i3c.source)
prev_ok=check_fail(:ok ok)

// --- test 3d: info(f).source elides a func with many space-separated
// bodies past cutoff(), same "{N more}" convention as a list ---
errmsg(:clear)
orig_cutoff3d=cutoff()
cutoff(2)
f3d=func(1 2 3 4 5)
i3d=info(f3d)
ok3d=(i3d.source=="func(\n  1\n  2\n  {3 more}\n)")
cutoff(orig_cutoff3d)
ok=ok&&ok3d
print("3d f3d=func(1 2 3 4 5) at cutoff(2); info(f3d).source, elided (expect func(1 2 {3 more}) with newlines): %v\n" i3d.source)
prev_ok=check_fail(:ok ok)

// --- test 3g: info(f).source breaks a ';'-chain nested inside a keyword
// value onto its own indented lines too, spliced bare like a func's own
// last span rather than wrapped in parens (which would reparse as a
// different, larger token stream) ---
errmsg(:clear)
f3g=func(x;if(x>0 :then y=1;return(y)))
i3g=info(f3g)
gg3g=run(i3g.source :str)
igg3g=info(gg3g)
ok3g=(i3g.source=="func(\n  x;\n  if(gt(x 0) :then\n    y=1;\n    return(y)\n  )\n)")&&(igg3g.ntoks==i3g.ntoks)
ok=ok&&ok3g
print("3g f3g=func(x;if(x>0 :then y=1;return(y))); info(f3g).source, nested ';'-chain indented: %v\n" i3g.source)
prev_ok=check_fail(:ok ok)

// --- test 3h: a ';'-chain of 3+ statements parses as a left-nested chain
// of binary seq nodes (a;b;c;d is {seq,{seq,{seq,a,b},c},d}); info(f).source
// flattens that spine into one statement per line at a single indent level
// rather than staircasing deeper parens per statement ---
f3h=func(a;b;c;d)
i3h=info(f3h)
g3h=run(i3h.source :str)
ig3h=info(g3h)
ok3h=(i3h.source=="func(\n  a;\n  b;\n  c;\n  d\n)")&&(ig3h.ntoks==i3h.ntoks)
ok=ok&&ok3h
print("3h f3h=func(a;b;c;d); info(f3h).source, flat 4-statement chain: %v\n" i3h.source)
prev_ok=check_fail(:ok ok)

// --- test 3i: info(f).source on if(cond :then ... :else ...) starts
// each keyword's value on its own line right after the keyword, and
// starts :else and the closing paren on their own lines at if('s own
// indent too, rather than any of them trailing the previous clause ---
f3i=func(x;if(x>0 :then a=1;return(a) :else b=2;return(b)))
i3i=info(f3i)
g3i=run(i3i.source :str)
ig3i=info(g3i)
ok3i=(i3i.source=="func(\n  x;\n  if(gt(x 0) :then\n    a=1;\n    return(a)\n  :else\n    b=2;\n    return(b)\n  )\n)")&&(ig3i.ntoks==i3i.ntoks)
ok=ok&&ok3i
print("3i f3i=func(x;if(x>0 :then a=1;return(a) :else b=2;return(b))); info(f3i).source, :else on its own line: %v\n" i3i.source)
prev_ok=check_fail(:ok ok)

// --- test 3j: info(f).source on for(init test step body) starts the
// body (its 4th argument) on its own indented line ---
f3j=func(for(i=0 i<10 i=i+1 print(i)))
i3j=info(f3j)
g3j=run(i3j.source :str)
ig3j=info(g3j)
ok3j=(i3j.source=="func(for(i=0 lt(i 10) i=add(i 1)\n    print(i)))")&&(ig3j.ntoks==i3j.ntoks)
ok=ok&&ok3j
print("3j f3j=func(for(i=0 i<10 i=i+1 print(i))); info(f3j).source, body on its own line: %v\n" i3j.source)
prev_ok=check_fail(:ok ok)

// --- test 3k: info(f).source on while(test body) starts the body on
// its own indented line, same as for()'s ---
f3k=func(i=0;while(i<10 print(i);i=i+1))
i3k=info(f3k)
g3k=run(i3k.source :str)
ig3k=info(g3k)
ok3k=(i3k.source=="func(\n  i=0;\n  while(lt(i 10)\n    print(i);\n    i=add(i 1))\n)")&&(ig3k.ntoks==i3k.ntoks)
ok=ok&&ok3k
print("3k f3k=func(i=0;while(i<10 print(i);i=i+1)); info(f3k).source, body on its own line: %v\n" i3k.source)
prev_ok=check_fail(:ok ok)

// --- test 3l: for()'s body and while()'s body each accept a ';'-chain
// bare, like a keyword value and func()'s own last span -- wrapping it
// in parens there reparses as a different, larger token stream ---
f3l=func(for(i=0 i<10 i=i+1 j=i*2;print(j)))
i3l=info(f3l)
g3l=run(i3l.source :str)
ig3l=info(g3l)
ok3l=(i3l.source=="func(for(i=0 lt(i 10) i=add(i 1)\n    j=mpy(i 2);\n    print(j)))")&&(ig3l.ntoks==i3l.ntoks)
ok=ok&&ok3l
print("3l f3l=func(for(i=0 i<10 i=i+1 j=i*2;print(j))); info(f3l).source, chain body spliced bare: %v\n" i3l.source)
prev_ok=check_fail(:ok ok)

// --- test 3m: if()'s keyword slots can hold a non-keyword positional
// (the literal call if(1 2), not valid if() usage but still reachable) --
// info(f).source renders it via the generic fallback instead of
// misreading it as a keyword tuple and crashing ---
// comlint:allow -- deliberately calls if() with an extra positional to exercise the fallback path under test
f3m=func(if(1 2))
i3m=info(f3m)
g3m=run(i3m.source :str)
ig3m=info(g3m)
ok3m=(i3m.source=="func(if(1 2\n  ))")&&(ig3m.ntoks==i3m.ntoks)
ok=ok&&ok3m
print("3m f3m=func(if(1 2)); info(f3m).source, positional in a keyword slot: %v\n" i3m.source)
prev_ok=check_fail(:ok ok)

// --- test 3n: a :then/:else value that is itself an if() keeps its
// own closing paren aligned with its own opening line, not the outer
// if('s depth ---
f3n=func(x;if(x>0 :then if(x>5 :then y=1 :else y=2) :else y=3))
i3n=info(f3n)
g3n=run(i3n.source :str)
ig3n=info(g3n)
ok3n=(i3n.source=="func(\n  x;\n  if(gt(x 0) :then\n    if(gt(x 5) :then\n      y=1\n    :else\n      y=2\n    )\n  :else\n    y=3\n  )\n)")&&(ig3n.ntoks==i3n.ntoks)
ok=ok&&ok3n
print("3n f3n=func(x;if(x>0 :then if(x>5 :then y=1 :else y=2) :else y=3)); info(f3n).source, nested if aligned: %v\n" i3n.source)
prev_ok=check_fail(:ok ok)

// --- test 3e: info(a.f) finds the FuncObj behind a dot expression
// without firing it, and a non-func dotted field falls through to its
// own ordinary info() dispatch instead of nil ---
errmsg(:clear)
sideeffect3e=0
al3e=attrlist(:f func(sideeffect3e=sideeffect3e+1; sideeffect3e) :x 42)
i3e=info(al3e.f)
i3ex=info(al3e.x)
ok3e=(class(i3e)==`AttributeList)&&(i3e.ntoks>0)&&(sideeffect3e==0)&&(i3ex==nil)
ok=ok&&ok3e
print("3e info(al3e.f) finds the FuncObj, never fires it; info(al3e.x) on a plain int falls through (expect true): %v\n" ok3e)
prev_ok=check_fail(:ok ok)

// --- test 3f: info(a.b.f) follows a nested dot chain to the FuncObj ---
errmsg(:clear)
al3f=attrlist(:b attrlist(:f func(1+2)))
i3f=info(al3f.b.f)
ok3f=(i3f.source=="func(add(1 2))")
ok=ok&&ok3f
print("3f info(al3f.b.f) follows a nested dot chain (expect func(add(1 2))): %v\n" i3f.source)
prev_ok=check_fail(:ok ok)

// --- test 4: info(f :posteval) reports true for a lazy func ---
errmsg(:clear)
f4=func(arg(0) :posteval)
i4=info(f4)
ok4=(i4.posteval==true)
ok=ok&&ok4
print("4 f4=func(arg(0) :posteval); info(f4).posteval (expect true): %v\n" ok4)
prev_ok=check_fail(:ok ok)

// --- test 5: info(fileobj) reports :filename :mode :open, open flips false after close() ---
errmsg(:clear)
fp5=open("./info-obj.comt" "r")
i5a=info(fp5)
close(fp5)
i5b=info(fp5)
ok5=(i5a.mode=="r")&&(i5a.open==true)&&(i5b.open==false)
ok=ok&&ok5
print("5 info(fileobj) before/after close() (expect mode \"r\", open true then false): %v\n" ok5)
prev_ok=check_fail(:ok ok)

// --- test 6: info(dateobj) round-trips through date() ---
errmsg(:clear)
d6=date(2026:Sep:27)
i6=info(d6)
d6b=date(i6)
ok6=(islist(i6 :colon))&&(d6b==d6)
ok=ok&&ok6
print("6 d6=date(2026:Sep:27); date(info(d6))==d6 (expect true): %v\n" ok6)
prev_ok=check_fail(:ok ok)

// --- test 7: info(timeobj) round-trips through time(), dateless and duration ---
errmsg(:clear)
t7a=time(1:2:3)
i7a=info(t7a)
t7b=time(0:5:0 :delta true)
i7b=info(t7b)
ok7=(time(i7a)==t7a)&&(time(i7b)==t7b)
ok=ok&&ok7
print("7 time(info(t)) round-trips a dateless instant and a duration (expect true): %v\n" ok7)
prev_ok=check_fail(:ok ok)

// --- test 8: info(sockobj) -- (:host :port) against a real comterp server ---
// requires lsof to confirm both the port was free before launch and that
// the launched server (not some other process) is what's listening --
// without it there is no way to tell a foreign server apart from our own,
// and server_down() below would shut down whatever socket() connected to.
errmsg(:clear)
have_lsof8=shell("which lsof > /dev/null 2>&1")==0
if(!have_lsof8 :then
  print("8 info(sockobj) -- SKIPPED, lsof not available to run this test safely\n")
:else
  port8=22301;
  while(shell(print("lsof -i :%d > /dev/null 2>&1" port8 :str))==0 port8=port8+1);
  shell(print("comterp server %d </dev/null > /dev/null 2>&1 &" port8 :str));
  cnt8=0;
  while(cnt8<40 && shell(print("lsof -iTCP:%d -sTCP:LISTEN > /dev/null 2>&1" port8 :str))!=0
    usleep(250000);cnt8=cnt8+1);
  sock8=socket("127.0.0.1" port8);
  if(type(sock8)==`UnknownType :then
    ok8=false;
    print("8 info(sockobj) (expect host/port) -- FAIL, server never listened on %d\n" port8)
  :else
    i8=info(sock8);
    ok8=(i8.host=="127.0.0.1")&&(i8.port==port8);
    print("8 info(sockobj) against 127.0.0.1:%d (expect true): %v\n" port8 ok8);
    remote(sock8 "exit" :nowait);
    close(sock8));
  ok=ok&&ok8)
prev_ok=check_fail(:ok ok)

// --- test 9: info(lst) reports :count :coloned :nested :cutoff on a plain list ---
errmsg(:clear)
l9=1,2,3,4
i9=info(l9)
c9=1:2
ic9=info(c9)
ok9=(i9.count==4)&&(i9.coloned==false)&&(i9.nested==false)&&(i9.cutoff==-1)&&(ic9.coloned==true)
ok=ok&&ok9
print("9 info(lst) plain vs. coloned (expect count 4, coloned false/true): %v\n" ok9)
prev_ok=check_fail(:ok ok)

// --- test 9b: info(lst).nested and .cutoff away from their defaults ---
// x9b's underlying list gets nested_insert(true) stamped on it the moment
// a symbol-table read of it becomes ':' 's first operand (colonlist.comt
// test 11) -- the same guard that keeps (x9b):3 from mutating x9b in place
errmsg(:clear)
x9b=1:2
y9b=(x9b):3
inest9b=info(x9b)
l9c=list(1,2,3,4,5 :cutoff 2)
icutoff9b=info(l9c)
ok9b=(inest9b.nested==true)&&(icutoff9b.cutoff==2)
ok=ok&&ok9b
print("9b info(lst).nested and .cutoff away from defaults (expect true, 2): %v %v\n" inest9b.nested icutoff9b.cutoff)
prev_ok=check_fail(:ok ok)

print("info-obj: %v\n" ok)
ok
