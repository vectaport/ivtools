// stream-literal.comt version 6
print("stream-literal.comt version 6\n")

// src/comterp_/tests/stream-literal.comt -- stream literal syntax tests
//
// coverage: 22 tests of stream literal feature
// funcs: postfix() errmsg() index() next() list() each() size() class() trace()
// tests 1-8:   parser tests (postfix inspection)
// tests 9-14:  stream literal runtime behavior
// tests 15-18: stream-of-streams construction, zip behavior, mixed elements
// test 19:     empty bracket literal []
// tests 20-22: unary-prefix-operator-led elements (*x, -x, ...)
//
// Run from inside comterp, comdraw, or drawserv:
//   run("src/comterp_/tests/stream-literal.comt")

// clear any prior error
errmsg(:clear)

run("./testlib.comt")
ok=true

// --- test 1: (42) is still a scalar -- no stream command in postfix ---
// BEFORE: passes  AFTER: passes  (single value, not a stream literal)
v=(42)
ok=ok&&(v==42)
p=postfix((42))
ok=ok&&(index(p "stream")==nil)
print("1 postfix((42)) -- scalar not stream (expect no 'stream' in postfix and v==42): %v %v\n" v p)
prev_ok=check_fail(:ok ok)

// --- test 2: (0 1) has stream command in postfix ---
// BEFORE: fails -- "Unexpected literal constant"
// AFTER:  passes -- stream[2|0|1]* in postfix
errmsg(:clear)
p=nil
p=postfix((0 1))
errmsg(:clear)
ok=ok&&(index(p "stream")!=nil)
print("2 postfix((0 1)) -- stream literal (expect 'stream' in postfix): %v\n" p)
prev_ok=check_fail(:ok ok)

// --- test 3: (0 1 2 3) has stream command with narg=4 ---
// BEFORE: fails
// AFTER:  passes -- stream[4|0|1]* in postfix
errmsg(:clear)
p=nil
p=postfix((0 1 2 3))
errmsg(:clear)
ok=ok&&(index(p "stream[4|0|1]")!=nil)
print("3 postfix((0 1 2 3)) -- stream[4|0|1] (expect stream[4|0|1] in postfix): %v\n" p)
prev_ok=check_fail(:ok ok)

// --- test 4: (42) postfix is just the literal ---
// BEFORE: passes  AFTER: passes
p=postfix((42))
ok=ok&&(p=="42")
print("4 postfix((42)) -- just literal (expect \"42\"): %v\n" p)
prev_ok=check_fail(:ok ok)

// --- test 5: (0 :flag 1) no error, stream literal narg=1 nkey=1 ---
// BEFORE: fails -- p=nil (error from run() prevents postfix from working)
// AFTER:  passes -- no error, stream[1|1|1]* in postfix
errmsg(:clear)
run("(0 :flag 1)" :str)
errmsg(:clear)
p=nil
p=postfix((0 :flag 1))
errmsg(:clear)
ok=ok&&(index(p "stream")!=nil)
print("5 postfix((0 :flag 1)) -- stream literal (expect 'stream' in postfix): %v\n" p)
prev_ok=check_fail(:ok ok)

// --- test 6: (0 1 :key 99) stream[3|1|1] in postfix ---
// BEFORE: fails -- p=nil
// AFTER:  passes -- stream[3|1|1]* in postfix
errmsg(:clear)
run("(0 1 :key 99)" :str)
errmsg(:clear)
p=nil
p=postfix((0 1 :key 99))
errmsg(:clear)
ok=ok&&(index(p "stream[3|1|1]")!=nil)
print("6 postfix((0 1 :key 99)) -- stream[3|1|1] (expect stream[3|1|1] in postfix): %v\n" p)
prev_ok=check_fail(:ok ok)

// --- test 7: (0 :key 1 2) still errors -- bare value after keyword ---
// BEFORE: passes  AFTER: passes  (always an error regardless of patch)
errmsg(:clear)
run("(0 :key 1 2)" :str)
e7=errmsg(:last)
ok=ok&&(e7!=nil)
print("7 (0 :key 1 2) -- error preserved (expect error): %v\n" e7)
prev_ok=check_fail(:ok ok)

// --- test 8: (:key val) still produces attrlist not stream ---
// BEFORE: passes  AFTER: passes  (keyword-first path unchanged)
errmsg(:last)
al=(:a 1 :b 2)
ok=ok&&(class(al)==`AttributeList)
p=postfix((:a 1 :b 2))
ok=ok&&(index(p "attrlist")!=nil)
ok=ok&&(index(p "stream")==nil)
print("8 (:a 1 :b 2) -- attrlist not stream (expect attrlist no stream in postfix): %v\n" p)
prev_ok=check_fail(:ok ok)

// =========================================================
// PART 2: Stream literal actual stream behavior
// (requires StreamLiteralNextFunc in strmfunc.c)
// =========================================================

// --- test 9: stream literal produces a working stream ---
// BEFORE strmfunc patch: next() returns nil (no StreamLiteralNextFunc)
// AFTER:  next() returns values lazily one at a time
s=(10 20 30)
v1=next(s); v2=next(s); v3=next(s); v4=next(s)
ok=ok&&(v1==10)
ok=ok&&(v2==20)
ok=ok&&(v3==30)
ok=ok&&(v4==nil)
print("9 next() on (10 20 30) (expect 10 20 30 nil): %v %v %v %v\n" v1 v2 v3 v4)
prev_ok=check_fail(:ok ok)

// --- test 10: stream literal is lazy -- rand evaluated fresh each next() ---
// BEFORE: nil
// AFTER:  three independently evaluated rand values
srand(42)
s=(rand rand rand)
r1=next(s)
r2=next(s)
r3=next(s)
ok=ok&&(r1!=empty())
ok=ok&&(r2!=empty())
ok=ok&&(r3!=empty())
print("10 (rand rand rand) lazy eval (expect 3 distinct rand values): %v %v %v\n" r1 r2 r3)
prev_ok=check_fail(:ok ok)

// --- test 11: nil in stream terminates early ---
// BEFORE: nil
// AFTER:  stream stops at nil, returns empty() on next call
s=(1 nil 3)
v1=next(s); v2=next(s)
ok=ok&&(v1==1)
ok=ok&&(v2==nil)
print("11 next() on (1 nil 3) -- nil terminates stream (expect 1 nil): %v %v\n" v1 v2)
prev_ok=check_fail(:ok ok)

// --- test 12: each() on stream literal returns count ---
// BEFORE: 0 or error
// AFTER:  4
ok=ok&&(each((10 20 30 40))==4)
print("12 each((10 20 30 40)) (expect 4): %v\n" each((10 20 30 40)))
prev_ok=check_fail(:ok ok)

// --- test 13: keyword element becomes singleton attrlist ---
// BEFORE fix: stream terminates after positionals, keyword element missing
// AFTER fix:  (0 :key 1) yields 0 then (:key 1) then nil
s=(0 :key 1)
v1=next(s); v2=next(s); v3=next(s)
ok=ok&&(v1==0)
ok=ok&&(class(v2)==`AttributeList)
ok=ok&&(v2.key==1)
ok=ok&&(v3==nil)
print("13 next() on (0 :key 1) -- keyword element as attrlist (expect 0 (:key 1) nil): %v %v %v\n" v1 v2 v3)
prev_ok=check_fail(:ok ok)

// --- test 14: stream literal and list duality ---
// (4 :b 3) as stream materializes to same list as {4,(:b 3)}
// BEFORE: stream literals didn't work
// AFTER:  list((4 :b 3)) == {4,(:b 3)}
l1=list((4 :b 3))
l2=list(4,((:b 3)))
ok=ok&&(size(l1)==2)
ok=ok&&(at(l1 0)==4)
ok=ok&&(class(at(l1 1))==`AttributeList)
ok=ok&&(at(l1 0)==at(l2 0))
ok=ok&&(class(at(l2 1))==`AttributeList)
print("14 list((4 :b 3)) -- list duality (expect {4,(:b 3)}): %v\n" l1)
prev_ok=check_fail(:ok ok)

// =========================================================
// PART 3: Stream-of-streams construction and zip behavior
// =========================================================

// --- test 15: nested stream literal syntax ((1 2 3)(4 5 6)) ---
// BEFORE fix: parse error -- "Unexpected left parenthesis"
// AFTER fix:  outer stream yields two independent inner StreamTypes lazily,
//             next() on each inner stream gives {1,2,3} and {4,5,6}
errmsg(:clear)
ss=nil
ss=((1 2 3)(4 5 6))
e15=errmsg(:last)
errmsg(:clear)
ok15=(e15==nil)
r0=next(ss); r1=next(ss); eot=next(ss)
ok15=ok15&&(class(r0)==`StreamType)
ok15=ok15&&(class(r1)==`StreamType)
ok15=ok15&&(eot==nil)
ok15=ok15&&(list(r0)==(1,2,3))
ok15=ok15&&(list(r1)==(4,5,6))
ok=ok&&ok15
print("15 ((1 2 3)(4 5 6)) -- nested stream literal (expect StreamType StreamType nil): %v %v %v\n" r0 r1 eot)
prev_ok=check_fail(:ok ok)

// --- test 16: $$(1,2,3),$$(4,5,6) -- comma overdriven by two streams zips them ---
// $$ binds tightly to next expr only; comma between two streams is overdriven
// and produces a zip stream of paired elements, NOT a stream-of-rows.
// This is the currently-working construction; result is a zip not nested streams.
// ACTUAL: list() gives {{1,4},{2,5},{3,6}}
ss2=$$(1,2,3),$$(4,5,6)
l16=list(ss2)
ok=ok&&(l16==((1,4),(2,5),(3,6)))
print("16 $$(1,2,3),$$(4,5,6) -- zip via overdriven comma (expect {{1,4},{2,5},{3,6}}): %v\n" l16)
prev_ok=check_fail(:ok ok)

// --- test 17: double zipper -- known unexpected behavior ---
// $$(($$(1,2,3),$$(4,5,6)),($$(11,12,13),$$(14,15,16)))
// EXPECTED if double zip were symmetric: {{1,4,11,14},{2,5,12,15},{3,6,13,16}}
// ACTUAL: {{1,4,{11,14}},{2,5,{12,15}},{3,6,{13,16}}}
// Second group arrives as StreamType and is appended as nested element
// rather than being zipped peer-to-peer with the first group.
// Root cause unknown -- preserved as regression/investigation anchor.
ss3=$$(($$(1,2,3),$$(4,5,6)),($$(11,12,13),$$(14,15,16)))
l17=list(ss3)
ok17=(l17==((1,4,{11,14}),(2,5,{12,15}),(3,6,{13,16})))
ok=ok&&ok17
print("17 $$(($$(1,2,3),$$(4,5,6)),($$(11,12,13),$$(14,15,16))) -- double zipper (expect {{1,4,11,14},{2,5,12,15},{3,6,13,16}} actual {{1,4,{11,14}},...}): %v\n" l17)
prev_ok=check_fail(:ok ok)

// --- test 18: mixed scalar + nested stream literal ---
// (1 (2 3) :key 4) -- a stream containing a scalar, an inner stream
// literal, and a keyword element, in that source order.
// next() yields 1, then StreamType{2,3}, then (:key 4), then nil.
//
// Previously this corrupted the stack ("func next pushed more than a
// single value on stack", leaving {1,2,3}).  Root cause: execute_literal()
// discovers positionals via backward postfix traversal (pi=0 = LAST source
// element), but assigned (offset,count) pairs as if discovery order
// matched tokbuf's forward order.  Correct only when all positionals are
// the same width -- (10 20 30) and ((1 2 3)(4 5 6)) (tests 9, 15) are both
// uniform-width and worked "by coincidence".  Fixed by collecting sizes
// then assigning offsets via reverse accumulation, appended in reverse-pi
// order so AVL element 0 = source positional 0.
errmsg(:clear)
s18=(1 (2 3) :key 4)
ok18=(class(s18)==`StreamType)
r18a=next(s18)
ok18=ok18&&(r18a==1)
r18b=next(s18)
ok18=ok18&&(class(r18b)==`StreamType)&&(list(r18b)==(2,3))
r18c=next(s18)
ok18=ok18&&(class(r18c)==`AttributeList)
r18d=next(s18)
ok18=ok18&&(r18d==nil)
ok=ok&&ok18
print("18 next((1 (2 3) :key 4)) -- mixed scalar+stream+keyword (expect 1 StreamType{2,3} (:key 4) nil): %v %v %v %v\n" r18a r18b r18c r18d)
prev_ok=check_fail(:ok ok)

// =========================================================
// PART 4: Empty bracket literal
// =========================================================

// --- test 19: [] is an empty stream, nil on first next() ---
// BEFORE fix: cascade of internal errors ("offlimit hit by
// ComTerp::skip_arg" etc.) -- empty brackets fell through to a bare
// blank token instead of constructing a stream, corrupting postfix
// bookkeeping and confusing AssignFunc.
// AFTER fix: [] parses like a zero-arg stream() call, matching how {}
// and () construct an empty list/attrlist; next() returns nil right away.
errmsg(:clear)
s19=[]
e19=errmsg(:last)
ok19=(e19==nil)
ok19=ok19&&(class(s19)==`StreamType)
r19=next(s19)
ok19=ok19&&(r19==nil)
ok=ok&&ok19
print("19 s=[]; next(s) -- empty stream literal (expect no error, StreamType, nil): %v %v\n" class(s19) r19)
prev_ok=check_fail(:ok ok)

// =========================================================
// PART 5: unary-prefix-operator-led elements
// =========================================================

// --- test 20: unary-prefix operator (*) leading every element ---
// (*s *s *s *s) -- BEFORE fix: "Unexpected operator (*)".  A bare paren
// doesn't know it's a stream literal (as opposed to a plain grouping or
// pending call) until the first element-boundary check fires, at which
// point it "slips in" stream_symid as its comm_id.  That slip-in was
// only implemented for literal- and identifier-led elements
// (ComUtil/_parser.c's TOK_COMMAND/default cases), not for operator-led
// ones (TOK_OPERATOR case) -- so whichever element is the first to need
// that check, if it's operator-led, the paren never gets marked as a
// stream literal, and the error fires right there.
// AFTER fix: parses like any other stream literal; *s (next(s), see
// starnext.comt) is evaluated once per element, in source order.
errmsg(:clear)
s20=(0 1 2 3 4 5 6 7)
ss20=(*s20 *s20 *s20 *s20)
e20=errmsg(:last)
ok20=(e20==nil)
r20a=next(ss20)
ok20=ok20&&(r20a==0)
r20b=next(ss20)
ok20=ok20&&(r20b==1)
r20c=next(ss20)
ok20=ok20&&(r20c==2)
r20d=next(ss20)
ok20=ok20&&(r20d==3)
r20e=next(ss20)
ok20=ok20&&(r20e==nil)
ok=ok&&ok20
print("20 (*s *s *s *s) -- unary-prefix * leads every element (expect no error, 0 1 2 3 nil): %v %v %v %v %v\n" r20a r20b r20c r20d r20e)
prev_ok=check_fail(:ok ok)

// --- test 21: unary minus (-) leading every element -- same fix, a
// different, much older operator, confirming this isn't specific to *.
errmsg(:clear)
n21=42
ss21=(-n21 -n21 -n21)
e21=errmsg(:last)
ok21=(e21==nil)
r21a=next(ss21)
ok21=ok21&&(r21a==-42)
r21b=next(ss21)
ok21=ok21&&(r21b==-42)
r21c=next(ss21)
ok21=ok21&&(r21c==-42)
r21d=next(ss21)
ok21=ok21&&(r21d==nil)
ok=ok&&ok21
print("21 (-n -n -n) -- unary minus leads every element (expect no error, -42 -42 -42 nil): %v %v %v %v\n" r21a r21b r21c r21d)
prev_ok=check_fail(:ok ok)

// --- test 22: mixed leading token kinds in one literal -- a plain
// literal, a plain identifier, an operator-led element, and another
// operator-led element (a different operator) all in source order,
// confirming they interoperate regardless of which one happens to be
// first to trip the stream-literal auto-detection.
errmsg(:clear)
m22=9
s22b=(100 200)
ss22=(1 m22 -m22 *s22b)
e22=errmsg(:last)
ok22=(e22==nil)
r22a=next(ss22)
ok22=ok22&&(r22a==1)
r22b=next(ss22)
ok22=ok22&&(r22b==9)
r22c=next(ss22)
ok22=ok22&&(r22c==-9)
r22d=next(ss22)
ok22=ok22&&(r22d==100)
r22e=next(ss22)
ok22=ok22&&(r22e==nil)
ok=ok&&ok22
print("22 (1 m -m *s2) -- literal, identifier, and two different operator-led elements in one literal (expect no error, 1 9 -9 100 nil): %v %v %v %v %v\n" r22a r22b r22c r22d r22e)
prev_ok=check_fail(:ok ok)

print("stream-literal: %v\n" ok)
ok
