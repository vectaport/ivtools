// src/comterp_/tests/selfdot.comt -- unary prefix . (selfdot command),
// reads/targets the currently-executing func's own home attrlist
//
// coverage: not yet scored
// funcs: selfdot func dot attrlist
//
// .field is sugar for dot(comterp's own current home attrlist).field --
// since both sides of an assignment are then genuine dot-expressions, the
// existing obj.field=otherobj.otherfield dispatch (AssignFunc, dotfunc.c)
// applies, so .f=.g copies a sibling FuncObj field without auto-firing it,
// the internal analogue of the already-working a.f=a.g from outside.
// .method(args) fires a sibling FuncObj field self-bound to the same home
// attrlist, the internal analogue of a.method(args) from outside.
// Outside any call frame .field has no home to resolve against and reads
// nil (postfix(.g) shows the unary selfdot parse: "g selfdot[1|0|1]").
//
// Run from inside comterp, comdraw, or drawserv (cd to this dir first):
//   run("./selfdot.comt")

run("./testlib.comt")
ok=true

// --- test 1: .field outside any func call has no home attrlist -- nil ---
r1=.nosuchframe
ok=ok&&(r1==nil)
print("1 .nosuchframe at top level, no call frame (expect nil): %v\n" r1)
check_fail(:ok ok)

// --- test 2: .f=.g inside a method copies the sibling FuncObj field
// without firing it -- a.f() afterward runs g's body, not f's original ---
a2=(:f2 func(1) :g2 func(2) :h2 func(.f2=.g2))
a2.h2()
r2=a2.f2()
ok=ok&&(r2==2)
print("2 a2.h2() does .f2=.g2; a2.f2() now runs g2's body (expect 2): %v\n" r2)
check_fail(:ok ok)

// --- test 3: .field reads/writes the real home attrlist, not a copy --
// a write inside one method is visible to a bare read in a sibling method
// called afterward on the same instance ---
a3=(:v3 1 :set3 func(.v3=42) :get3 func(.v3))
a3.set3()
r3=a3.get3()
ok=ok&&(r3==42)
print("3 a3.set3() does .v3=42; a3.get3() sees it via the real attrlist (expect 42): %v\n" r3)
check_fail(:ok ok)

// --- test 4: .method(args) fires a sibling FuncObj field self-bound to
// the caller's own home attrlist, same as a.method(args) from outside ---
a4=(:g4 func(temp(x)=arg(0);x+1) :f4 func(.g4(5)))
r4=a4.f4()
ok=ok&&(r4==6)
print("4 a4.f4() does .g4(5), self-bound sibling call (expect 6): %v\n" r4)
check_fail(:ok ok)

print("selfdot: %v\n" ok)
ok
