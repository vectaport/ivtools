// src/comterp_/tests/funcclosure.comt -- test func() closures via
// declaration-time capture (#310)
//
// funcs: func local global
//
// A func() body's free variables (read-only or read-before-write, per
// #170's taxonomy) are captured once, at declaration time, instead of
// resolved dynamically at call time -- turning func() into a real
// closure.  Either kind is live state, not a frozen snapshot: a body
// write to it, OR an explicit keyword override at any call site, updates
// that FuncObj's own captures list, so the next bare call sees whichever
// value the previous call left, private to that one closure instance
// (test 3, test 8, test 9, test 10) -- read-only names persist a keyword
// override the same way even though the body itself never writes them.
// A body that writes a name before ever reading it (even to nil) opts
// that name out of capture entirely -- pure local scratch, reset every
// call, untouched by any of this (test 4).  local()/global() stay fully
// dynamic, unaffected.
//
// Run from inside comterp, comdraw, or drawserv (cd to this dir first):
//   run("./funcclosure.comt")

run("./testlib.comt")
ok=true

// --- test 1: read-before-write variable is captured at declaration time,
// not resolved dynamically at call time ---
c=10
f=func(arg(0)+c)
c=999
r=f(1)
ok=ok&&(r==11)
print("1 c=10; f=func(arg(0)+c); c=999; f(1) uses captured c (expect 11): %v\n\n" r)
check_fail(:ok ok)

// --- test 2: read-only variable is also captured, and stays robust
// against later, unrelated changes to the outer scope (the exact
// fragility funcarg.comt test 9 documents for the pre-#310 dynamic
// fallthrough behavior) ---
x=nil
ini=func(if(x==nil :then 99 :else x))
x=5
r1=ini()
ok=ok&&(r1==99)
print("2 x=nil; ini=func(if(x==nil :then 99 :else x)); x=5; ini() still sees captured nil (expect 99): %v\n\n" r1)
check_fail(:ok ok)

// --- test 3: an explicit keyword override on a read-only capture (the
// body never assigns it) persists as the new default too, the same as a
// read-before-write capture's body-driven write would ---
c=10
g=func(c)
c=999
r2=g()
r3=g(:c 55)
r3b=g()
ok=ok&&(r2==10)&&(r3==55)&&(r3b==55)
print("3 c=10; g=func(c); c=999; g() vs g(:c 55) vs g() again (expect 10 55 55): %v %v %v\n\n" r2 r3 r3b)
check_fail(:ok ok)

// --- test 4: write-before-read opts a name out of capture entirely --
// assigning it first (even to nil) makes it pure local scratch ---
y=42
h=func(y=nil; y)
r4=h()
ok=ok&&(r4==nil)&&(y==42)
print("4 y=42; h=func(y=nil; y); h() local scratch, outer y untouched (expect nil, y stays 42): %v %v\n\n" r4 y)
check_fail(:ok ok)

// --- test 5: local()/global() stay fully dynamic, unaffected by capture --
// a body that only ever reads/writes a name through local()/global()
// never captures it at all ---
z=5
k=func(local(z)=local(z)+1)
r5=k()
z=100
r6=k()
ok=ok&&(r5==6)&&(r6==101)
print("5 z=5; k=func(local(z)=local(z)+1); k() then z=100; k() tracks live local(z) (expect 6 101): %v %v\n\n" r5 r6)
check_fail(:ok ok)

// --- test 6: a self-bound method's read-before-write of an object's own
// field must stay live, never shadowed by a stale declaration-time
// capture of an unrelated same-named outer variable (or lack thereof) --
// this is the collision case: "count" is never a free variable in scope
// when obj.increment is declared, but obj already owns a :count field ---
obj=(:count 5)
obj.increment = func(count=count+1)
r7 = obj.increment()
r8 = obj.increment()
ok=ok&&(r7==6)&&(r8==7)
print("6 obj=(:count 5); obj.increment=func(count=count+1) obj's own field stays live (expect 6 7): %v %v\n\n" r7 r8)
check_fail(:ok ok)

// --- test 7: a self-bound method can still close over a genuine outer
// free variable at the same time its self-bound field access stays live
// -- the two mechanisms coexist without interfering ---
factor=10
obj2=(:val 5)
obj2.scale = func(val=val*factor)
r9 = obj2.scale()
factor=999
r10 = obj2.scale()
ok=ok&&(r9==50)&&(r10==500)
print("7 factor=10; obj2.scale=func(val=val*factor); factor=999; obj2's val stays live, factor stays captured (expect 50 500): %v %v\n\n" r9 r10)
check_fail(:ok ok)

// --- test 8: a self-bound method's own capture of a genuine free
// variable (never on the object) is real closure state -- it persists
// across calls to that one bound method, private to the closure, never
// spilling onto the object as a permanent field of its own.  c's
// declaration-time value (10) only seeds the first call; obj3 keeps its
// original single field (:y) throughout, and the outer c is untouched ---
c=10
obj3=(:y 1)
obj3.bump = func(c=c+1)
r11 = obj3.bump()
r12 = obj3.bump()
r13 = obj3.bump()
ok=ok&&(r11==11)&&(r12==12)&&(r13==13)&&(obj3.y==1)&&(size(obj3)==2)&&(c==10)
print("8 c=10; obj3.bump=func(c=c+1) called 3x, c persists as the closure's own state (expect 11 12 13, obj3 keeps just :y/:bump, outer c untouched): %v %v %v\n\n" r11 r12 r13)
check_fail(:ok ok)

// --- test 9: a name that's both a genuine capture and an explicit
// keyword at the same call defers entirely to the keyword mechanism --
// the capture must not revert a write the keyword call legitimately
// caused to stick (attrlist.comt test 43's exact shape) ---
obj4=(:setit func(nope=nope+1; nope))
r14 = obj4.setit(:nope 5)
ok=ok&&(r14==6)&&(obj4.nope==6)
print("9 obj4.setit(:nope 5) with nope both captured and keyword-supplied (expect 6, obj4.nope==6): %v %v\n\n" r14 obj4.nope)
check_fail(:ok ok)

// --- test 10: a plain (non-dot) func's read-before-write capture persists
// an explicit keyword override too, the same as a bare body write does --
// a subsequent bare call continues from the override, not from the
// declaration-time value ---
setit2=func(nope2=nope2+1; nope2)
r15 = setit2(:nope2 5)
r16 = setit2()
ok=ok&&(r15==6)&&(r16==7)
print("10 setit2=func(nope2=nope2+1; nope2); setit2(:nope2 5) then setit2() (expect 6 7): %v %v\n\n" r15 r16)
check_fail(:ok ok)

// --- test 11: a :posteval func's explicit keyword for a capture that the
// body never actually reads (an untaken branch) stays an unresolved
// pending argument -- persisting it as-is would leave captures() holding
// a dangling pointer once cleanup frees that argument, corrupting or
// crashing a later bare call. The declaration-time default must survive
// untouched instead ---
z18=1
f18=func(if(false :then z18=z18+9); z18 :posteval)
r17 = f18(:z18 999)
r18 = f18()
r19 = f18()
ok=ok&&(r17==999)&&(r18==1)&&(r19==1)&&(z18==1)
print("11 z18=1; f18=func(if(false :then z18=z18+9); z18 :posteval); f18(:z18 999) then f18() f18() (expect 999 1 1, z18 untouched): %v %v %v\n\n" r17 r18 r19)
check_fail(:ok ok)

// --- test 12: a variable that appears ONLY as a keyword's own bound
// value (if()'s :then/:else branches) is still captured at declaration
// time, exactly as an ordinary positional read would be -- it must not
// silently fall through to live dynamic lookup ---
a=true
b=100
c=100
f20=func(if(a :then b :else c))
r20=help(f20)
ok=ok&&(r20=="f20(:a [true] :b [100] :c [100])")
b=999
r21=f20()
ok=ok&&(r21==100)
print("12 a=true;b=100;c=100;f20=func(if(a :then b :else c)); help(f20) then b=999;f20() (expect \"f20(:a [true] :b [100] :c [100])\" 100): %v %v\n\n" r20 r21)
check_fail(:ok ok)

// --- test 13: same gap, general form -- a variable passed as `:key var`
// to any command (not just if()'s :then/:else) is captured too; a bare
// flag keyword with no bound value at all (:err below) must not crash or
// falsely capture anything ---
d=10
g20=func(attrlist(:x d))
r22=help(g20)
ok=ok&&(r22=="g20(:d [10])")
d=999
r23=g20()
ok=ok&&(r23.x==10)
j20=func(if(true :err))
r24=help(j20)
ok=ok&&(r24=="j20()")
print("13 d=10; g20=func(attrlist(:x d)); help(g20) then d=999;g20().x (expect \"g20(:d [10])\" 10); j20=func(if(true :err)); help(j20) (expect \"j20()\"): %v %v %v\n\n" r22 r23.x r24)
check_fail(:ok ok)

// --- test 14: a self-bound method's keyword override on a read-only
// capture persists as the new default too, the same as a plain (non-dot)
// func() call already does -- the dot-bound call path applies such an
// override through the same ephemeral-keyword mechanism as an ordinary
// keyword, so it needs its own persist step back into the closure's
// captures rather than reverting the override away entirely ---
x30=5
obj30=(:y 1)
obj30.m = func(x30)
r30=obj30.m()
r31=obj30.m(:x30 7)
r32=obj30.m()
ok=ok&&(r30==5)&&(r31==7)&&(r32==7)
print("14 x30=5; obj30.m=func(x30); obj30.m() vs obj30.m(:x30 7) vs obj30.m() again (expect 5 7 7): %v %v %v\n\n" r30 r31 r32)
check_fail(:ok ok)

// --- test 15: a keyword bound to a compound expression, not a bare
// variable, must not be misread as a direct capture of that expression's
// leading token -- `local(x)` reads x live through local(), so :x must
// not show up in help() as a declaration-time capture ---
x31=5
f31=func(attrlist(:k local(x31)))
r33=help(f31)
ok=ok&&(r33=="f31()")
print("15 x31=5; f31=func(attrlist(:k local(x31))); help(f31) (expect \"f31()\", no spurious :x31 capture): %v\n\n" r33)
check_fail(:ok ok)

// --- test 16: a bare flag keyword (:flag, no value) synthesizes true for
// that one call only -- persisting it would force the capture true forever
// after a single bare use, defeating the point of an optional flag.  An
// explicit value (:flag true/:flag false) still persists as usual. ---
f32=func(if(flag!=nil :then 1 :else 0))
r34=f32()
r35=f32(:flag)
r36=f32()
ok=ok&&(r34==0)&&(r35==1)&&(r36==0)
print("16 f32=func(if(flag!=nil :then 1 :else 0)); f32() vs f32(:flag) vs f32() again (expect 0 1 0 -- bare flag doesn't persist): %v %v %v\n\n" r34 r35 r36)
check_fail(:ok ok)

f33=func(if(flag!=nil :then 1 :else 0))
r37=f33()
r38=f33(:flag true)
r39=f33()
ok=ok&&(r37==0)&&(r38==1)&&(r39==1)
print("16b f33(:flag true) with an explicit value still persists (expect 0 1 1): %v %v %v\n\n" r37 r38 r39)
check_fail(:ok ok)

// --- test 17: a body write to a bare-flag capture, during the very call
// that set the flag, still persists -- only an untouched bare-flag true
// is excluded, not the variable itself ---
f34=func(if(flag!=nil :then flag=8); flag)
r40=f34()
r41=f34(:flag)
r42=f34()
ok=ok&&(r40==nil)&&(r41==8)&&(r42==8)
print("17 f34=func(if(flag!=nil :then flag=8); flag); f34() vs f34(:flag) vs f34() again (expect nil 8 8 -- body's own write during the bare-flag call persists): %v %v %v\n\n" r40 r41 r42)
check_fail(:ok ok)

// --- test 17b: a body write that happens to write the same literal true
// the bare flag synthesized still persists -- the untouched/written
// distinction is tracked by a tag on the synthesized value, not by
// comparing the final value against true ---
f34b=func(if(flag!=nil :then flag=true); flag)
r40b=f34b()
r41b=f34b(:flag)
r42b=f34b()
ok=ok&&(r40b==nil)&&(r41b==true)&&(r42b==true)
print("17b f34b=func(if(flag!=nil :then flag=true); flag); f34b() vs f34b(:flag) vs f34b() again (expect nil true true -- body's own write of true still persists): %v %v %v\n\n" r40b r41b r42b)
check_fail(:ok ok)

// --- test 18: a dot-bound method's bare flag keyword doesn't persist
// either, matching a plain func's behavior; a body write during the same
// bare-flag call still sticks ---
obj35=(:m func(if(flag!=nil :then 1 :else 0)))
r43=obj35.m()
r44=obj35.m(:flag)
r45=obj35.m()
ok=ok&&(r43==0)&&(r44==1)&&(r45==0)
print("18 obj35.m=func(if(flag!=nil :then 1 :else 0)); obj35.m() vs obj35.m(:flag) vs obj35.m() again (expect 0 1 0 -- bare flag doesn't persist on a dot-bound call): %v %v %v\n\n" r43 r44 r45)
check_fail(:ok ok)

obj36=(:m func(if(flag!=nil :then flag=8); flag))
r46=obj36.m()
r47=obj36.m(:flag)
r48=obj36.m()
ok=ok&&(r46==nil)&&(r47==8)&&(r48==8)
print("18b obj36.m=func(if(flag!=nil :then flag=8); flag); obj36.m() vs obj36.m(:flag) vs obj36.m() again (expect nil 8 8): %v %v %v\n\n" r46 r47 r48)
check_fail(:ok ok)

obj37=(:m func(if(flag!=nil :then flag=true); flag))
r49=obj37.m()
r50=obj37.m(:flag)
r51=obj37.m()
ok=ok&&(r49==nil)&&(r50==true)&&(r51==true)
print("18c obj37.m=func(if(flag!=nil :then flag=true); flag); obj37.m() vs obj37.m(:flag) vs obj37.m() again (expect nil true true -- body's own write of true still persists on a dot-bound call): %v %v %v\n\n" r49 r50 r51)
check_fail(:ok ok)

// --- test 18d: a bare keyword nested inside a positional argument's own
// sub-expression (if()'s :err) must not be mistaken for the method's own
// bare flag -- scanning raw tokens instead of top-level spans would
// misattribute it and overrun the method's own bareflag bookkeeping ---
obj38=(:m func(if(flag!=nil :then 1 :else 0)))
r52=obj38.m(if(true :err))
r53=obj38.m(if(true :err) :flag)
r54=obj38.m(if(true :err))
ok=ok&&(r52==0)&&(r53==1)&&(r54==0)
print("18d obj38.m(if(true :err)) vs obj38.m(if(true :err) :flag) vs obj38.m(if(true :err)) again (expect 0 1 0 -- nested :err doesn't corrupt the method's own bare-flag tracking): %v %v %v\n\n" r52 r53 r54)
check_fail(:ok ok)

print("funcclosure: %v\n" ok)
ok
