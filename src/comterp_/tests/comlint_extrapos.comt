// src/comterp_/tests/comlint_extrapos.comt -- regression test for
// comlint's max-positional-arguments check: asserts its exact
// diagnostic output on a fixture script, rather than only that comlint
// runs without crashing -- see comlint_extrapos_fixture.comt for what
// each case exercises.
//
// Run from inside comterp, comdraw, or drawserv:
//   run("src/comterp_/tests/comlint_extrapos.comt")

run("./testlib.comt")
ok=true

/* see comlint_globalshadow.comt's own comment for why this probe and
   this per-line drain exist */
if(open("../../scripts/comlint" "r")!=nil :then
  comlintpath="../../scripts/comlint";fixtureprefix=""
  :else
  comlintpath="src/scripts/comlint";fixtureprefix="src/comterp_/tests/")

pipe1=$$open(print("comterp run %s %s%s 2>&1"
  comlintpath fixtureprefix "comlint_extrapos_fixture.comt" :str) :pipe)
out1="";linev1=*pipe1
while(linev1!=nil
  out1=out1+linev1+" ";
  linev1=*pipe1)

// --- line 28 (ep_noThen=if(1 2), missing :then) is flagged plainly,
//     the exact motivating case (test 1); line 30 (ep_then, written
//     correctly with :then) and line 32 (ep_switch, called the real
//     way with :case keywords) are not flagged (tests 2-3) -- a call
//     supplying any keyword skips the positional-arity check entirely,
//     switch() included; line 34 (ep_open, two bare positionals against
//     open()'s nested [filename [modestr]] group) is not flagged,
//     confirming both nested positions count toward the max, not just
//     the outer bracket (test 4); line 36 (ep_atOk, at()'s ordinary
//     2-positional form) is not flagged, confirming a top-level "|"
//     alternation ("list|attrlist|compview") counts as one required
//     slot, not one per alternative (test 5); line 39 (ep_allow, a
//     missing-:then call) is overridden by its space-indented
//     comlint:allow line (test 6); line 42 (ep_allowTab, the same)
//     is overridden by a TAB-indented comlint:allow line rather than
//     plainly flagged (test 7) ---
noThenFlagged=index(out1 "fixture.comt:28: WARN: if(): called with 2 positional argument(s), but if accepts at most 1" :substr)!=nil
thenClean=index(out1 "fixture.comt:30:" :substr)==nil
switchClean=index(out1 "fixture.comt:32:" :substr)==nil
openClean=index(out1 "fixture.comt:34:" :substr)==nil
atClean=index(out1 "fixture.comt:36:" :substr)==nil
allowOverridden=index(out1 "fixture.comt:39: WARN(overridden): if(): called with 2 positional argument(s), but if accepts at most 1" :substr)!=nil
allowTabOverridden=index(out1 "fixture.comt:42: WARN(overridden): if(): called with 2 positional argument(s), but if accepts at most 1" :substr)!=nil
ok=ok&&noThenFlagged&&thenClean&&switchClean&&openClean&&atClean&&allowOverridden&&allowTabOverridden
print("1 comlint flags if(1 2)'s missing :then (expect true), leaves\n    if(1 :then 2 :else 3), switch()'s real :case-keyword form, open()'s\n    nested-bracket positionals, and at()'s top-level-alternation form\n    unflagged (expect true x4), and overrides both a space-indented\n    and a tab-indented comlint:allow line rather than flagging them\n    plainly (expect true x2): %v %v %v %v %v %v %v\n\n"
  noThenFlagged thenClean switchClean openClean atClean allowOverridden allowTabOverridden)
prev_ok=check_fail(:ok ok)

print("\ncomlint_extrapos: %v\n" ok)
ok
