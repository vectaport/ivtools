#! /usr/bin/env comterp_run
#
# comlint  lint a .comt script's command calls against each command's own
#          help()/dockeys() signature
#
# Usage:  comlint script.comt [program] [nokeys]
#
# program selects which family member's registered commands and
# docstrings to check against (comterp, comdraw, drawserv, ...);
# defaults to comterp. nokeys disables the unknown-keyword check (see
# below) entirely, for a script that leans on different commands
# silently ignoring different keywords by design.

if(arg(1)=="help" || arg(1)=="-h" || arg(1)==nil ||
  arg(1)=="-help" || arg(1)=="--help" :then

    print("comlint  lint a .comt script against each command's own signature\n");
    print("Usage:  comlint script.comt [program] [nokeys]\n\n");
    print("program picks which family member's commands to check against\n");
    print("(comterp, comdraw, drawserv, ...); defaults to comterp.\n\n");
    print("Every finding is FAIL (always blocks), WARN (blocks unless\n");
    print("overridden), or HINT (reported, never blocks). A WARN is\n");
    print("overridden by a '// comlint:allow -- <reason>' comment line\n");
    print("preceding the flagged statement -- blank lines and other\n");
    print("comments in between don't matter, only the next statement's\n");
    print("own start consumes it.\n\n");
    print("FAIL: a plain assignment (name=value, or a compound += form)\n");
    print("to a name that also names a registered command -- ComTerp\n");
    print("itself refuses the assignment, so it's a guaranteed no-op.\n\n");
    print("WARN: a call passing fewer positional arguments than the\n");
    print("command requires, or more than it accepts (a command whose\n");
    print("signature ends '...' takes an unbounded number and is never\n");
    print("flagged for too many); a :keyword the command doesn't declare in\n");
    print("its own signature or dockeys() (pass 'nokeys' to disable this\n");
    print("one check entirely); a bare write to a name already declared\n");
    print("global() earlier in the script (see doc/LANGUAGE.md for how\n");
    print("local()/func() scoping and global(:clear) narrow this one).\n\n");
    print("Never executes the target script.\n\n");
    print("A call using a keyword skips the positional-arity check (an\n");
    print("alternate calling convention it can't validate) but still gets\n");
    print("its keyword names checked. Statements spanning multiple lines\n");
    print("(a for/while/func body) or joined with ';' are checked too --\n");
    print("only dot-attribute calls (a.name(...)) are skipped entirely.\n");
    print("See doc/LANGUAGE.md.\n");
    exit)

target=arg(1)
program=arg(2)
if(program==nil :then program="comterp")
nokeysarg=arg(3)
checkkeys=true
if(nokeysarg=="nokeys" :then checkkeys=false)

if(program!="comterp" && arg(4)!="direct" :then
  /* comdraw/drawserv's -runfile has no argv-forwarding to arg(n) the
     way comterp's `run` subcommand does, so this same script
     can't just be invoked under $program directly and see its own
     positional arguments the normal way. Instead, shell out
     (shell()/open(:pipe) both exist in ComTerp) to $program with a
     patched copy of this script's own source (read via its own
     arg(0) path) that has every reference to positional arguments 1
     through 4 textually replaced with a literal constant -- target,
     program, nokeysarg, and "direct" (a guard at position 4, past the
     user-facing arg(3), so the patched copy doesn't try to delegate
     again) -- built with nothing but ComTerp primitives
     (open/gets/index/substr/print), no external tooling
     beyond shell() itself to invoke $program.

     The replaced pattern strings below are built by concatenation
     (not written as one contiguous literal) so this substitution
     pass can't find and corrupt its own source when it runs. */

  /* program ends up interpolated into shell() command strings below
     (shell() is system(), no argv-array form to bypass a shell), so
     it must be restricted to a safe character set first -- otherwise
     a program value containing shell metacharacters is a straight
     command injection (confirmed exploitable: `; touch /tmp/x ;`
     as the program argument ran touch). */
  safechars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-";
  pvchars=split(program);pvi=0;badprogram=false;
  while(pvi<size(pvchars)
    if(index(safechars at(pvchars pvi))==nil :then badprogram=true);
    pvi=pvi+1);
  if(badprogram :then
    print("comlint: program name has characters outside [A-Za-z0-9_./-]: %s\n" program :err);
    exit(1));

  /* target never reaches a shell command (it's only ever embedded as
     a ComTerp string literal in the generated file below), but it
     must not contain a '"' or '\' -- both are significant inside a
     "..." literal (\ starts an escape, unescaped " ends the string)
     and there's no ComTerp string-escaping primitive to lean on, so
     reject rather than risk mis-escaping into the wrong path. */
  if(index(target "\"")!=nil || index(target "\\")!=nil :then
    print("comlint: target path contains a '\"' or '\\', not supported: %s\n" target :err);
    exit(1));

  foundcmd=print("command -v %s >/dev/null 2>&1" program :str);
  if(shell(foundcmd)!=0 :then
    print("comlint: program '%s' not found on PATH\n" program :err);
    exit(1));

  /* processed and written one line at a time -- print(:file)'s %s
     formatting truncates a very long single string (confirmed a real
     ComTerp bug: a >1KB string written via print("%s" str :file f)
     silently truncates to ~1KB), so this script's own source is
     never held or written as one giant string at once */
  pat1="arg"+"("+"1"+")";rep1="\""+target+"\"";
  pat2="arg"+"("+"2"+")";rep2="\""+program+"\"";
  pat3="arg"+"("+"3"+")";rep3="nil";
  if(nokeysarg!=nil :then rep3="\""+nokeysarg+"\"");
  pat4="arg"+"("+"4"+")";rep4="\"direct\"";

  /* tmppath is only somewhat unpredictable (time + a random suffix)
     in shared /tmp, with no atomic-create primitive available from
     ComTerp (open() has no :excl/O_EXCL equivalent), so
     this is a best-effort mitigation against guessing, not a real
     fix for the underlying TOCTOU/symlink race */
  selfpath=arg(0);
  sf=open(selfpath "r");
  tmppath=print("/tmp/comlint_%v_%v.comt" time(:raw :ms) rand(0,999999) :str);
  tf=open(tmppath "w");

  sline=gets(sf);
  while(sline!=nil
    pattern=pat1;replacement=rep1;
    result="";remaining=sline;loopdone=false;
    while(!loopdone
      pos=index(remaining pattern);
      if(pos==nil :then result=result+remaining;loopdone=true;continue);
      result=result+substr(remaining pos)+replacement;
      remaining=substr(remaining pos+size(pattern) :after));
    sline=result;

    pattern=pat2;replacement=rep2;
    result="";remaining=sline;loopdone=false;
    while(!loopdone
      pos=index(remaining pattern);
      if(pos==nil :then result=result+remaining;loopdone=true;continue);
      result=result+substr(remaining pos)+replacement;
      remaining=substr(remaining pos+size(pattern) :after));
    sline=result;

    pattern=pat3;replacement=rep3;
    result="";remaining=sline;loopdone=false;
    while(!loopdone
      pos=index(remaining pattern);
      if(pos==nil :then result=result+remaining;loopdone=true;continue);
      result=result+substr(remaining pos)+replacement;
      remaining=substr(remaining pos+size(pattern) :after));
    sline=result;

    pattern=pat4;replacement=rep4;
    result="";remaining=sline;loopdone=false;
    while(!loopdone
      pos=index(remaining pattern);
      if(pos==nil :then result=result+remaining;loopdone=true;continue);
      result=result+substr(remaining pos)+replacement;
      remaining=substr(remaining pos+size(pattern) :after));
    sline=result;

    print("%s" sline :file tf);
    sline=gets(sf));
  close(sf);
  close(tf);

  cmd=print("%s -stdin_off -runfile %s" program tmppath :str);
  status=shell(cmd);
  shell(print("rm -f %s" tmppath :str));
  exit(status/256))

fp=open(target "r")
if(fp==nil :then
  print("comlint: unable to open %s\n" target :err);
  exit(1))

print("comlint: checking %s against %s's command set\n" target program)

/* nfail is always-blocking; nwarn is unresolved WARN (blocks); nwarnok is
   WARN found but suppressed by a preceding '// comlint:allow' comment
   (reported, doesn't block) -- see allowarmed below. No check currently
   emits HINT (reported, never blocks); the category exists for a future
   softer check. */
nfail=0
nwarn=0
nwarnok=0
nchecked=0
nskipped=0
nhelpcalls=0
lineno=0
mlbal=0
incomm=0
idchars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_"

/* a command's declared-keyword-set and positional-arity facts are both
   pure functions of its docstring, so each is scanned from help() at
   most once per distinct command name and kept in a global variable
   named by symvar()/symval() (not dot-attributes, which namespace by
   the lexical token at the call site, not by the symbol value a
   variable holds -- confirmed by trial against the interpreter) --
   reused by every later call site for that command, whether checking
   keywords or positional arity */
kwcachepfx="_comlint_kwcache_"
aritycachepfx="_comlint_aritycache_"

/* a call marker is a "name[nargs|nkeys|misc]" token, optionally suffixed
   '*' -- always a trailing shape with nothing after it, which is what
   distinguishes a real one from a plain string-literal token that merely
   contains '[' and ']' characters of its own (e.g. a pgrep pattern like
   "'[d]rawserv'") and would otherwise be misread as a call.
   subtreestart(toks idx) is called as
   subtreestart(attrlist(:pftoks toks :pfidx idx)) -- a single packed
   argument, read back as arg(0) -- never as two positional args
   ("list(toks idx)" doesn't pack either: list() takes exactly one
   value and copies/converts it, so a second positional arg is
   silently dropped). This script re-execs a textually patched copy of
   its own source under comdraw/drawserv (see "program" above), which
   finds-and-replaces the literal text "arg(1)"/"arg(2)"/"arg(3)"/
   "arg(4)" ANYWHERE in the file, oblivious to func scoping -- a second
   positional func arg here would read back as the OUTER script's own
   target/program/nokeysarg instead of this func's real argument. */
global(comlint_pf)=(:subtreestart func(
  /* walking backward from a call's own marker token to find its
     supplied keywords (see the :then/:else search below) must skip
     clean over a NESTED call's entire argument/keyword span, never
     wander into it token-by-token -- a nested call's own keyword
     markers would otherwise be mistaken for the outer call's. This
     returns the index of the first token of the value/call subtree
     whose own last token sits at idx, so the caller can jump straight
     there instead of stepping backward one token at a time. */
  temp(packed)=arg(0);temp(toks)=packed.pftoks;temp(idx)=packed.pfidx;
  temp(tok)=at(toks idx);
  temp(lb)=index(tok "[");
  temp(rb)=if(lb!=nil :then index(tok "]" :last) :else nil);
  temp(tsz)=size(tok);
  temp(iscall)=(lb!=nil && rb!=nil &&
    (rb==tsz-1 || (rb==tsz-2 && substr(tok tsz-1 :after)=="*")));
  if(!iscall :then
    /* a string literal containing an embedded newline renders back
       through postfix() as several comma-joined fragments, one token
       each -- a fragment that isn't the first carries the whole
       preceding fragment as one more token to skip */
    temp(res)=idx;temp(more)=true;
    while(more && res>0
      temp(ptok)=at(toks res-1);temp(plen)=size(ptok);
      temp(iscont)=(plen>=2 && substr(ptok plen-2 :after)=="\",");
      if(iscont :then res=res-1 :else more=false));
    return(res));
  temp(counts)=substr(substr(tok lb+1 :after) "]");
  temp(ctoks)=split(counts :tokstr '|');
  if(size(ctoks)<2 :then return(idx));
  temp(cnargs)=int(at(ctoks 0));temp(cnkeys)=int(at(ctoks 1));
  temp(j)=idx-1;
  temp(kcovered)=0;
  temp(ki)=0;
  while(ki<cnkeys && j>=0
    temp(ktok)=at(toks j);
    temp(kp)=index(ktok "(");
    temp(kargn)=1;
    if(kp!=nil :then
      temp(kcountstr)=substr(substr(ktok kp+1 :after) ")");
      if(size(kcountstr)>0 :then kargn=int(kcountstr)));
    j=j-1;
    temp(vi)=0;
    while(vi<kargn && j>=0
      j=global(comlint_pf).subtreestart(attrlist(:pftoks toks :pfidx j))-1;
      vi=vi+1);
    kcovered=kcovered+kargn;
    ki=ki+1);
  temp(ai)=0;
  temp(remaining)=cnargs-kcovered;
  while(ai<remaining && j>=0
    j=global(comlint_pf).subtreestart(attrlist(:pftoks toks :pfidx j))-1;
    ai=ai+1);
  j+1))

/* armed by a '// comlint:allow -- <reason>' comment line and consumed by
   the next statement's own first line, whatever blank lines or other
   comments sit in between -- only a non-matching comment line clears it
   early (see the comment-line branch in the main loop below). */
allowarmed=false

/* names seen as the lvalue of a global(name)=... assignment so far, and
   the line each was first seen -- only that assign form actually
   creates the table entry (confirmed against real runs: a bare read
   global(name), with no "=value", never does, not even the multi-arg
   global(a b) form -- see the assignment-text scan's comment, in the
   main loop below, on how the assign/clear forms are recognized).
   flaggedglobal is the subset already reported, so a name bare-written
   many times after its global()=... only gets one finding. clearedglobal
   is the subset later cleared via the bare, valueless global(name
   :clear) -- once cleared, a name is never flagged again even if it's
   later re-seen in globalnames without an intervening fresh
   global(name)=... registration, trading a possible missed
   re-declaration for no false positive; a fresh global(name)=... after
   a clear removes the name from clearedglobal again, matching the real
   table (confirmed: global(x)=1;global(x :clear);global(x)=2;x=3;
   global(x) reads 3). localnames is the set ever named as the lvalue of
   a local(name)=... assignment anywhere in the script -- local()
   searches before global() (see comterp.c's "func scope -> local ->
   global" order), so a later bare write to a name in localnames lands
   in the local table, not the global one, whatever global() also
   declared -- suppressed permanently once seen, the same conservative
   trade-off as clearedglobal. */
globalnames=list();globallines=list();flaggedglobal=list()
clearedglobal=list();localnames=list()

/* every bare-lvalue name the shadow-scan below finds, paired with its
   own statement's line -- the command-shadow FAIL check (istype()/
   help() via eval()) runs on these AFTER the scan finishes rather than
   during it, and the scan itself is plain top-level iterative code
   (an explicit worknodes/workinfunc stack), never a func() call: a
   func()'s own variables -- even ones declared global() -- don't
   reliably see a change made outside that func between calls
   (confirmed with a minimal repro: a counter incremented only from
   inside a func(), called repeatedly from a plain top-level loop,
   reads back as its pre-loop value once the loop ends -- global()
   makes a func's write visible to a *later, separate* global() read,
   not to the ambient script scope this loop already relies on
   everywhere else), so any state this scan accumulates has to live in
   the same top-level scope the rest of this script already uses. */
shadownames=list();shadowlines=list()

/* a statement spanning several physical lines (a for/while/func body,
   most commonly) is buffered here -- one line at a time, tracking a
   running paren DEPTH across the whole statement -- and only handed to
   postfix() once balanced back to zero, joined with '\n' exactly as it
   appeared in the source. postfix() (like eval()/help() elsewhere in
   this script) parses without ever firing the statement, so buffering
   never risks executing target script code -- PROVIDED the
   depth never goes negative mid-statement: a premature ')' would close
   this script's own postfix(%s) wrapper early, and anything after it up
   to the next ';' becomes a second, independently-executed top-level
   statement once eval() sees the interpolated string. stmtbad latches
   that condition so the whole statement is rejected outright, whatever
   its FINAL balance settles to. ';' itself needs no
   special casing: it's ComTerp's own sequencing operator, so a line
   with balanced parens containing one is already a single complete,
   checkable statement -- postfix() reads "x=1;y=2" as one seq[...] node
   the same as any other expression. */
stmtbuf="";stmtlineno=0;stmtnlines=0;stmtbad=false

while((srcline=gets(fp))!=nil
  lineno=lineno+1;

  /* gets() includes the line's own trailing newline, so a truly blank
     source line reads back as "\n" (size 1), never size 0 -- checking
     size alone only ever catches a final line with no trailing newline
     at all. Without this, a blank line falls through as its own trivial
     no-op statement, silently consuming an armed comlint:allow before
     the statement it was meant for ever sees it. */
  if(srcline=="\n" || size(srcline)==0 :then continue);
  if(substr(srcline 2)=="//" :then
    /* an unrelated whole-line comment leaves an already-armed override
       alone -- only the next real statement's own start consumes it
       (stmtallowed=allowarmed;allowarmed=false below), so the override
       applies across any number of intervening comment lines. The
       comment's own text (past "//" and any leading spaces or tabs) must
       start with "comlint:allow", not merely mention it anywhere --
       a plain substring search would also arm on unrelated prose that
       happens to name the override, such as a header comment
       documenting this very feature. */
    cmtbody=substr(srcline 2 :after);
    while(size(cmtbody)>0 && (substr(cmtbody 1)==" " || substr(cmtbody 1)=="\t")
      cmtbody=substr(cmtbody 1 :after));
    if(substr(cmtbody 13)=="comlint:allow" :then allowarmed=true);
    continue);

  hasopen=index(srcline "/*");
  hasclose=index(srcline "*/");
  if(incomm>0 :then
    if(hasclose!=nil :then incomm=0);
    nskipped=nskipped+1;continue);
  if(hasopen!=nil :then
    if(hasclose==nil :then incomm=1);
    nskipped=nskipped+1;continue);

  /* parens inside a "..." string literal or a '(' / ')' char literal
     (or after an escaping backslash) aren't structural -- e.g.
     print("(expect true)" ...) or this very script's own
     pc=='(' :then mlbal=mlbal+1 -- so track quote/char state
     (escape-aware) while counting rather than treating every raw
     '(' / ')' character as real syntax. A '//' outside a string/char
     literal starts a line comment (to the end of this physical line
     only) whose parens don't count either. mlbal is a running DEPTH
     across the whole buffered statement, not a per-line net -- checked
     for going negative the instant a ')' is seen, since that's the
     premature-close injection this guards against (see the comment
     above stmtbuf's reset).

     Scanned by jumping straight to the nearest structurally-relevant
     character (index() on the whole remaining line) instead of
     visiting every character with at() -- a backslash always wins the
     jump (it escapes whatever follows, in or out of a literal, so
     that next character is skipped without examining it), otherwise
     the nearest of the state's own relevant markers (just the closing
     delimiter inside a string/char literal; quote-open/char-open/
     paren-open/paren-close/comment-start outside one) is handled and
     the line resumes right after it. Runs of ordinary characters
     between markers are skipped in one hop rather than one at a
     time. */
  remaining=srcline;instr=0;inchr=0;
  while(size(remaining)>0
    bpos=index(remaining "\\");
    term=nil;kind=nil;
    if(instr>0 :then
      term=index(remaining "\"");kind="closeq");
    if(inchr>0 :then
      term=index(remaining "'");kind="closec");
    if(instr==0 && inchr==0 :then
      tq=index(remaining "\"");
      tc=index(remaining "'");
      to=index(remaining "(");
      tk=index(remaining ")");
      tcm=index(remaining "//");
      term=nil;kind=nil;
      if(tq!=nil && (term==nil||tq<term) :then term=tq;kind="openq");
      if(tc!=nil && (term==nil||tc<term) :then term=tc;kind="openc");
      if(to!=nil && (term==nil||to<term) :then term=to;kind="open");
      if(tk!=nil && (term==nil||tk<term) :then term=tk;kind="close");
      if(tcm!=nil && (term==nil||tcm<term) :then term=tcm;kind="comment"));

    if(bpos!=nil && (term==nil || bpos<=term) :then
      nextpos=bpos+2;
      if(nextpos>=size(remaining) :then remaining="" :else remaining=substr(remaining nextpos :after));
      continue);

    if(term==nil :then remaining="";continue);

    if(kind=="closeq" :then instr=0;remaining=substr(remaining term+1 :after);continue);
    if(kind=="closec" :then inchr=0;remaining=substr(remaining term+1 :after);continue);
    if(kind=="openq" :then instr=1;remaining=substr(remaining term+1 :after);continue);
    if(kind=="openc" :then inchr=1;remaining=substr(remaining term+1 :after);continue);
    if(kind=="comment" :then remaining="";continue);
    if(kind=="open" :then mlbal=mlbal+1;remaining=substr(remaining term+1 :after);continue);
    if(kind=="close" :then
      mlbal=mlbal-1;
      if(mlbal<0 :then stmtbad=true);
      remaining=substr(remaining term+1 :after);continue));

  if(stmtnlines==0 :then
    stmtlineno=lineno;stmtbuf=srcline;
    stmtallowed=allowarmed;allowarmed=false);
  if(stmtnlines>0 :then stmtbuf=stmtbuf+"\n"+srcline);
  stmtnlines=stmtnlines+1;

  if(stmtbad :then
    /* a premature ')' was seen somewhere in this statement -- reject it
       outright, whatever mlbal now reads; never hand it to eval() */
    nskipped=nskipped+stmtnlines;
    stmtbuf="";stmtnlines=0;mlbal=0;stmtbad=false;continue);

  /* not balanced yet -- keep buffering. Not counted as skipped: once
     the statement completes it is checked in full, so no line of it
     was actually skipped. */
  if(mlbal>0 :then continue);

  if(mlbal<0 :then
    /* more closes than opens across the buffered statement -- malformed
       input, or a paren our string/comment-aware tracker still missed
       -- give up on this statement rather than mis-feed postfix() */
    nskipped=nskipped+stmtnlines;
    stmtbuf="";stmtnlines=0;mlbal=0;continue);

  stmt=stmtbuf;stmtline=stmtlineno;
  stmtbuf="";stmtnlines=0;

  /* flag a plain assignment (name=value, or a compound +=/-=/etc. form)
     to a symbol name that also names a registered command -- assigning
     to it this way either warns and no-ops (a bare command, no args) or
     silently rebinds it out from under every later call -- and register
     or clear a global(name)/local(name) declaration, so a later bare
     write to an already-declared global is flagged too. postfix(stmt
     :tree) (like postfix(stmt) and help() elsewhere in this script)
     parses without ever firing the statement, so this never risks
     executing target script code.

     Walked with an explicit worknodes/workinfunc stack (LIFO via
     popping the last element each time) rather than a recursive
     helper -- see shadownames' own comment above for why nothing here
     can be a func() call. A tree node is a list whose first element is
     the command symbol and whose rest are its own operands, each
     itself such a list or a leaf value; infunc carries whether a node
     is nested inside a func(...) body. A dot-attribute call
     (a.name(...)) resolves to whatever a.name is bound to, not the
     same-named global/local/func builtin, so its own call node is
     walked generically (its arguments still checked) without
     global/local/assign/func's special treatment applying to it --
     matching how the arity/keyword check below skips a dot call by its
     own dot[...] postfix tag. It's a no-op on anything that isn't
     list-shaped, so a stmt postfix(:tree) can't make sense of (nil, or
     some other leaf) is silently skipped rather than specially
     detected, the same statement still going on to the arity/keyword
     check below, which has its own istype(pftext StringType) guard on
     postfix(stmt). */
  treecmd=print("postfix(%s :tree)" stmt :str);
  tree=eval(treecmd);
  worknodes=list();workinfunc=list();
  if(islist(tree) :then worknodes=worknodes,tree;workinfunc=workinfunc,false);

  while(size(worknodes)>0
    node=at(worknodes nil :del);infunc=at(workinfunc nil :del);
    if(!islist(node) :then continue);

    head=at(node 0);headstr=print(head :str);nsz=size(node);

    if(headstr=="dot" :then
      call=at(node 2);ci=size(call)-1;
      while(ci>=1
        worknodes=worknodes,at(call ci);workinfunc=workinfunc,infunc;
        ci=ci-1);
      worknodes=worknodes,at(node 1);workinfunc=workinfunc,infunc;
      continue);

    if(headstr=="global"||headstr=="local" :then
      /* a folded keyword operand answers its own name via dot access
         (nil when absent, and equally nil -- never a crash -- on a
         plain leaf operand that isn't a keyword at all) */
      isclear=false;ci=1;
      while(ci<nsz
        op=at(node ci);
        if(op.clear!=nil :then isclear=true);
        ci=ci+1);
      if(isclear && headstr=="global" && nsz>=2 :then
        gname0=print(at(node 1) :str);
        if(index(clearedglobal gname0)==nil :then
          clearedglobal=clearedglobal,gname0));
      /* still queue this call's own operands, in source order (pushed
         back to front, since the worklist pops its most recent push
         first) -- an embedded assignment inside a computed argument
         (e.g. local(symadd(f(x=1)))) is still a real bare write to
         find, and a later operand's declaration/write must be seen
         after an earlier one's, not before it */
      ci=nsz-1;
      while(ci>=1
        worknodes=worknodes,at(node ci);workinfunc=workinfunc,infunc;
        ci=ci-1);
      continue);

    isassignfam=(headstr=="assign"||headstr=="mod_assign"||headstr=="mpy_assign"||
      headstr=="add_assign"||headstr=="sub_assign"||headstr=="div_assign");

    if(isassignfam :then
      lhs=at(node 1);rhs=at(node 2);
      lhshead=nil;
      if(islist(lhs) :then lhshead=print(at(lhs 0) :str));

      /* queued so a global/local lvalue's own :clear is honored (and
         any nested assignment in lhs or rhs is found) whatever else
         this statement also does -- rhs pushed first so it pops after
         lhs, matching their left-to-right source order */
      worknodes=worknodes,rhs;workinfunc=workinfunc,infunc;
      worknodes=worknodes,lhs;workinfunc=workinfunc,infunc;

      if((lhshead=="global"||lhshead=="local") && size(lhs)==2 :then
        gname=print(at(lhs 1) :str);
        if(lhshead=="global" :then
          gcidx=index(clearedglobal gname);
          if(gcidx!=nil :then at(clearedglobal gcidx :del));
          if(index(globalnames gname)==nil :then
            globalnames=globalnames,gname;
            globallines=globallines,stmtline)
        :else
          if(index(localnames gname)==nil :then
            localnames=localnames,gname))
      :else if(!islist(lhs) :then
        name=print(lhs :str);

        if(!infunc :then
          gidx=index(globalnames name);
          if(gidx!=nil && index(clearedglobal name)==nil &&
            index(localnames name)==nil &&
            index(flaggedglobal name)==nil :then
            flaggedglobal=flaggedglobal,name;
            gline=at(globallines gidx);
            wtag=if(stmtallowed :then "WARN(overridden)" :else "WARN");
            print("%s:%v: %s: global(%s) declares %s global here\n" target gline wtag name name);
            print("%s:%v: %s: %s=...: writes it bare -- lands in the same global, not a fresh local -- wrap in local(%s) if a private copy was intended, or global(%s) if the global update is intentional\n"
              target stmtline wtag name name name);
            if(stmtallowed :then nwarnok=nwarnok+1 :else nwarn=nwarn+1)));

        /* the command-shadow FAIL check itself needs eval() (istype()/
           help() on a dynamically-built name), run below once this
           whole tree is walked rather than here */
        shadownames=shadownames,name;
        shadowlines=shadowlines,stmtline));
      continue);

    if(headstr=="func" :then
      fi=nsz-1;
      while(fi>=1
        worknodes=worknodes,at(node fi);workinfunc=workinfunc,true;
        fi=fi-1);
      continue);

    /* generic node (includes "seq", a ';'-joined statement sharing one
       line): push operands back to front so the worklist, which pops
       its most recent push first, processes them in their original
       left-to-right order -- a later operand's declaration/write must
       never be seen before an earlier one's on the same line */
    gi=nsz-1;
    while(gi>=1
      worknodes=worknodes,at(node gi);workinfunc=workinfunc,infunc;
      gi=gi-1));

  /* the command-shadow FAIL check itself, deferred out of the walk
     above (see shadownames' own comment) */
  shdi=0;
  while(shdi<size(shadownames)
    sname=at(shadownames shdi);sline=at(shadowlines shdi);
    istypecmd=print("istype(%s CommandType)" sname :str);
    isshadowcmd=eval(istypecmd);
    if(isshadowcmd==true :then
      hsig=sname;
      helpcmd=print("help(%s)" sname :str);
      helptext=eval(helpcmd);
      if(istype(helptext StringType) :then
        hlines=split(helptext :tokstr '\n');
        hsig=at(hlines 0));
      print("%s:%v: FAIL: %s=...: \"%s\" is a registered command (%s) -- assigning to it will have no effect\n"
        target sline sname sname hsig);
      nfail=nfail+1);
    shdi=shdi+1);
  shadownames=list();shadowlines=list()

  pfcmd=print("postfix(%s)" stmt :str);
  pftext=eval(pfcmd);
  if(!istype(pftext StringType) :then nskipped=nskipped+1;continue);

  toks=split(pftext :tokstr ' ');
  ti=0;
  while(ti<size(toks)
    tok=at(toks ti);
    ti=ti+1;

    lb=index(tok "[");
    if(lb==nil :then continue);
    rb=index(tok "]" :last);
    if(rb==nil :then continue);

    name=substr(tok "[");
    /* dot's docstring documents the "." operator via a parenthetical
       aside ahead of its real signature ("(.) makes compound
       variables | dotlst=dot(name) -- ..."), which the arg-list
       extraction below mistakes for the signature itself, misreading
       its arity for every dot-access expression in a script -- skip
       it by name until that docstring parses cleanly on its own */
    if(name=="dot" :then continue);

    counts=substr(substr(tok lb+1 :after) "]");
    ctoks=split(counts :tokstr '|');
    if(size(ctoks)<2 :then continue);
    obsnarg=int(at(ctoks 0));
    obsnkey=int(at(ctoks 1));

    /* dot-attribute access (a.name(...)) resolves to whatever a.name
       is bound to, not the same-named global/local command -- postfix
       still labels the call with the target command's arity, but tags
       it with an immediately-following dot[...] token (postfix(a.b(1))
       is "a 1 b[1|0|1]* dot[2|0|1]*"), so a dot-called global()/local()
       (e.g. obj.global(x), a real method call, not the declaration --
       confirmed via postfix(x.global(a)) tagging it dot[2|0|1]*) never
       registers a declaration below, and is skipped for the
       arity/keyword checks further down too -- an unrelated bare call
       of the same name elsewhere in the statement still gets checked */
    /* dot-attribute access (a.name(...)) resolves to whatever a.name
       is bound to, not the same-named global/local command -- postfix
       still labels the call with the target command's arity, but tags
       it with an immediately-following dot[...] token (postfix(a.b(1))
       is "a 1 b[1|0|1]* dot[2|0|1]*"), so a dot-called global()/local()
       (e.g. obj.global(x), a real method call, not the declaration --
       confirmed via postfix(x.global(a)) tagging it dot[2|0|1]*) is
       skipped for the arity/keyword checks further down -- an
       unrelated bare call of the same name elsewhere in the statement
       still gets checked. (Registering a global()/local() declaration
       itself happens earlier, in the assignment-text scan above --
       see the comment there for why postfix() isn't used for that.) */
    nexttok=at(toks ti);
    isdotcall=(substr(nexttok 4)=="dot[");
    if(isdotcall :then continue);

    nchecked=nchecked+1;

    if(obsnkey>0 :then
      /* a call that supplies a keyword commonly uses an alternate
         calling convention (e.g. class(:comps), global(:dump)) that
         the single-signature-line positional-arity check below can't
         validate -- skip that check, but the keyword names themselves
         are still checkable against the command's declared set,
         independent of arity */
      kwcsym=symadd(kwcachepfx+name);
      kwcval=symval(kwcsym);
      kwcachehit=istype(kwcval ObjectType);
      if(kwcachehit :then
        declared=kwcval.declared;
        wildcard=kwcval.wildcard);
      if(!kwcachehit :then
        /* fetching and re-parsing help()'s text is the whole cost this
           cache exists to avoid, so it only happens here, on a miss --
           a repeat call to an already-cached command never touches
           help() at all */
        helpcmd=print("help(%s)" name :str);
        helptext=eval(helpcmd);
        nhelpcalls=nhelpcalls+1;
        if(!istype(helptext StringType) :then continue);
        /* help() on a name this comlint process never defined (a local
           func() the target script only creates via its own run(),
           which comlint deliberately never executes) answers ""
           rather than nil -- the same "nothing to validate against"
           case as an unparseable signature below, just arriving as an
           empty string instead of a missing one */
        if(size(helptext)==0 :then continue);
        helplines=split(helptext :tokstr '\n');
        declared=" ";wildcard=false;hli=0;
        while(hli<size(helplines) && !wildcard
          hline=at(helplines hli);
          hli=hli+1;
          /* three documented wildcard idioms mean any keyword name is
             accepted: ":<name>" (attrlist's [:<name> [val]]),
             ":key val..." (echo's [:key val...]), and ":keyword value"
             (setattr's [:keyword value [...]]) -- skip this whole
             command's keyword check rather than flag a name it
             deliberately doesn't enumerate */
          if(index(hline ":<")!=nil || index(hline ":key ")!=nil ||
            index(hline ":keyword ")!=nil :then
            wildcard=true;continue);
          /* a dockeys() line is always "        :name[ placeholder]
             <padding>description..." (helpfunc.c pads every entry with
             a fixed 8-space indent) -- but split(:tokstr) trims that
             indent off, so the reliable signal left is that a dockeys
             line's first character is ':' where a signature line's
             never is (it always leads with a return-value prefix or the
             command name itself). The declared name on a dockeys line is
             only its first token. A signature line has no comparable
             indent to strip, and a keyword there can glue straight onto
             an opening paren with no separating space (e.g. beep's
             "beep(:count)"), so it needs a character scan rather than
             space-tokenizing, bounded to before " -- " so a free-text
             description mentioning :name-shaped return-value fields
             (e.g. grid's "grid(:table) -- ... list of (:grid :comptype
             ...) rows") is never read as more accepted keywords */
          isdockeys=(substr(hline 1)==":");
          if(isdockeys :then
            htoks=split(hline :tokstr ' ');hti=0;firsttok=nil;
            while(hti<size(htoks) && firsttok==nil
              htok=at(htoks hti);
              hti=hti+1;
              if(size(htok)>0 :then firsttok=htok));
            if(firsttok!=nil :then
              atoks=split(firsttok :tokstr '|');ati=0;
              while(ati<size(atoks)
                atok=at(atoks ati);
                ati=ati+1;
                if(substr(atok 1)!=":" :then continue);
                /* ":str|:string" aliases two spellings for one keyword --
                   check each alias separately */
                nm=":";nci=1;nchars=split(atok);
                while(nci<size(nchars)
                  nc=at(nchars nci);
                  nci=nci+1;
                  if(index(idchars nc)==nil :then break);
                  nm=nm+nc);
                if(size(nm)>1 :then declared=declared+nm+" "))));
          if(!isdockeys :then
            dd=index(hline " -- ");
            if(dd==nil :then scanpart=hline);
            if(dd!=nil :then scanpart=substr(hline dd));
            schars=split(scanpart);sci=0;
            while(sci<size(schars)
              sc=at(schars sci);
              sci=sci+1;
              if(sc!=':' :then continue);
              nm=":";innerdone=false;
              while(sci<size(schars) && !innerdone
                sc2=at(schars sci);
                if(index(idchars sc2)==nil :then innerdone=true;continue);
                nm=nm+sc2;
                sci=sci+1);
              if(size(nm)>1 :then declared=declared+nm+" "))));
        /* attrlist(:declared declared ...) with the value variable named
           the same as its own keyword parses the value as a bare symbol
           instead of evaluating the variable -- alias to a differently
           named local first */
        kwdeclared=declared;kwwildcard=wildcard;
        symvar(kwcsym)=attrlist(:declared kwdeclared :wildcard kwwildcard));

      if(!wildcard :then
        /* the keyword markers this call actually supplied are the
           obsnkey nearest keyword-shaped markers walking back from
           this call's own marker -- keywords are always the last
           thing evaluated before a call fires ("Fixed Before Keywords
           Always", doc/LANGUAGE.md), so they're the nearest matches in
           the flat postfix stream. A keyword's own value (e.g. if()'s
           :then/:else branch) is skipped wholesale via subtreestart()
           once its marker is found, rather than walked token-by-token
           -- that value may itself be, or contain, a nested call using
           its own keywords, which must never be mistaken for this
           call's. A non-keyword call marker met before any keyword of
           this call's own is skipped the same way, for the same
           reason. */
        kfound=0;kidx=ti-2;
        while(kfound<obsnkey && kidx>=0
          ktok=at(toks kidx);
          iskw=(substr(ktok 1)==":" && index(ktok "(")!=nil);
          if(!iskw :then
            if(index(ktok "[")!=nil :then
              kidx=global(comlint_pf).subtreestart(attrlist(:pftoks toks :pfidx kidx))-1
            :else
              kidx=kidx-1);
            continue);
          kp=index(ktok "(");
          kwname=substr(ktok "(");
          kcountstr=substr(substr(ktok kp+1 :after) ")");
          kargn=if(size(kcountstr)>0 :then int(kcountstr) :else 1);
          kidx=kidx-1;
          kvi=0;
          while(kvi<kargn && kidx>=0
            kidx=global(comlint_pf).subtreestart(attrlist(:pftoks toks :pfidx kidx))-1;
            kvi=kvi+1);
          if(size(kwname)<=1 :then continue);
          kfound=kfound+1;
          /* bound the search in its own variable rather than writing
             index(declared (kwname+" ")) -- declared is a plain value,
             not a command, so a space-separated paren group glues
             onto it as an ignored call attempt and silently drops the
             search pattern (the exact failure mode this tool exists
             to catch) */
          searchfor=kwname+" ";

          if(checkkeys && index(declared searchfor)==nil :then
            wtag=if(stmtallowed :then "WARN(overridden)" :else "WARN");
            print("%s:%v: %s: %s(): unrecognized keyword %s\n"
              target stmtline wtag name kwname);
            if(stmtallowed :then nwarnok=nwarnok+1 :else nwarn=nwarn+1))));
      continue);

    acsym=symadd(aritycachepfx+name);
    acval=symval(acsym);
    acachehit=istype(acval ObjectType);
    if(acachehit :then
      noarity=acval.noarity;
      required=acval.required;
      maxopt=acval.maxopt;
      unbounded=acval.unbounded);
    if(!acachehit :then
      helpcmd=print("help(%s)" name :str);
      helptext=eval(helpcmd);
      nhelpcalls=nhelpcalls+1;
      if(!istype(helptext StringType) :then continue);
      if(size(helptext)==0 :then continue);
      helplines=split(helptext :tokstr '\n');
      sig=at(helplines 0);
      op=index(sig "(");
      dd=index(sig " -- ");
      /* a "(" found only past " -- " belongs to the free-text
         description (e.g. spread's "...into a stream (or list)..."),
         not a signature -- this docstring has no real one, so it must
         be treated the same as op==nil rather than mined for an arglist */
      noarity=(op==nil || dd==nil || op>dd);
      if(!noarity :then
        /* cutting at the first ")" (rather than the one matching the "("
           just found) truncates a signature whose own arg list embeds a
           parenthetical before its real close, e.g. time()'s
           "...:min(local)|y:Mon..." -- stopping at "(local)"'s ")" drops
           everything after it, including the "]" that would otherwise
           close its enclosing bracket and credit it toward maxopt */
        after=substr(sig op+1 :after);
        achars=split(after);
        pdepth=0;
        pci=0;
        pend=nil;
        while(pci<size(achars) && pend==nil
          pc=at(achars pci);
          if(pc=='(' :then pdepth=pdepth+1);
          if(pc==')' :then
            if(pdepth==0 :then pend=pci :else pdepth=pdepth-1));
          pci=pci+1);
        noarity=(pend==nil);
        if(!noarity :then
          arglist=substr(after pend);
          if(arglist==nil :then arglist="");

          /* scanned character by character, not space-tokenized: a bracket
             group can hold several space-separated names (gridspacing's
             "[xsize ysize]", both count toward the max, not just the one
             slot the group itself occupies) and "|" alternatives -- at the
             top level (substr's "str n|str", at's "list|attrlist|compview")
             or inside a group (colors' "[fgcolornum bgcolornum |
             fgcolorname bgcolorname]") -- take the max of either side's
             count, not their sum, since only one side is ever supplied at
             once. run0/max0 is the top level (feeding required the same way
             a bracket feeds maxopt); run1-3/max1-3 track up to 3 levels of
             "[" nesting (open's "[filename [modestr]]" is 2). runN is the
             token count since level N's last "|" (or its start), maxN the
             highest count an alternative at that level has reached so far.
             bdepth (not "depth") -- comdraw/drawserv register a depth()
             command of their own, and this script runs under whichever
             program it's checking. */
          argchars=split(arglist);
          maxopt=0;
          unbounded=false;
          bdepth=0;
          run0=0;run1=0;run2=0;run3=0;
          max0=0;max1=0;max2=0;max3=0;
          word="";
          donescan=false;
          aci=0;
          while(aci<size(argchars) && !donescan
            ch=at(argchars aci);
            aci=aci+1;
            /* split() yields CharType elements, not 1-char strings -- '['
               compares a CharType literal against them; a quoted "[" would
               silently and permanently compare false (no CharType/StringType
               coercion), making isstruct always false and this whole scan a
               no-op that just accumulates the entire arglist into one word */
            isstruct=(ch=='[' || ch==']' || ch=='|' || ch==' ');
            if(!isstruct :then word=word+ch;continue);

            if(size(word)>0 :then
              /* checked as a substring, not an exact token match, since
                 "..." can be glued onto a bracket with no separating space
                 (help's [command...]) or onto a value name (sum()'s
                 "valn..."/"...,valn") -- either way this word is a repeat
                 marker, not a positional slot of its own, and it makes the
                 max-positional check skipped entirely for this command */
              haselip=(index(word "...")!=nil);
              if(haselip :then unbounded=true);
              iskw=(substr(word 1)==":");
              if(bdepth==0 && iskw :then donescan=true);
              if(!donescan && !iskw && !haselip :then
                if(bdepth==0 :then run0=run0+1);
                if(bdepth==1 :then run1=run1+1);
                if(bdepth==2 :then run2=run2+1);
                if(bdepth==3 :then run3=run3+1));
              word="");

            if(donescan :then continue);

            if(ch=='[' :then
              bdepth=bdepth+1;
              if(bdepth==1 :then run1=0;max1=0);
              if(bdepth==2 :then run2=0;max2=0);
              if(bdepth==3 :then run3=0;max3=0);
              continue);

            if(ch=='|' :then
              if(bdepth==0 :then max0=if(run0>max0 :then run0 :else max0);run0=0);
              if(bdepth==1 :then max1=if(run1>max1 :then run1 :else max1);run1=0);
              if(bdepth==2 :then max2=if(run2>max2 :then run2 :else max2);run2=0);
              if(bdepth==3 :then max3=if(run3>max3 :then run3 :else max3);run3=0);
              continue);

            if(ch==']' :then
              if(bdepth==1 :then
                cand=if(run1>max1 :then run1 :else max1);
                maxopt=maxopt+cand;
                bdepth=0);
              if(bdepth==2 :then
                cand=if(run2>max2 :then run2 :else max2);
                bdepth=1;
                run1=run1+cand);
              if(bdepth==3 :then
                cand=if(run3>max3 :then run3 :else max3);
                bdepth=2;
                run2=run2+cand);
              continue));

          /* flush a trailing word never followed by a space/bracket/pipe --
             doesn't occur for any signature in this codebase today (every
             arglist either ends in "]" or a lone required name before the
             closing paren already stripped off by the substr() above), kept
             only so a future signature shaped that way doesn't silently
             drop its last positional */
          if(size(word)>0 && !donescan && bdepth==0 :then
            if(index(word "...")==nil && substr(word 1)!=":" :then
              run0=run0+1));

          required=if(run0>max0 :then run0 :else max0)));
      /* same value/keyword name-collision pitfall as the keyword cache
         above -- alias before building the attrlist */
      acnoarity=noarity;acrequired=required;acmaxopt=maxopt;acunbounded=unbounded;
      symvar(acsym)=attrlist(:noarity acnoarity :required acrequired :maxopt acmaxopt :unbounded acunbounded));

    if(noarity :then continue);

    if(obsnarg<required :then
      wtag=if(stmtallowed :then "WARN(overridden)" :else "WARN");
      print("%s:%v: %s: %s(): called with %v positional argument(s), but %s requires %v -- likely call-glue collapse; check for a bare symbol immediately followed by an unrelated parenthesized argument\n"
        target stmtline wtag name obsnarg name required);
      if(stmtallowed :then nwarnok=nwarnok+1 :else nwarn=nwarn+1));

    maxargs=required+maxopt;
    if(!unbounded && obsnarg>maxargs :then
      wtag=if(stmtallowed :then "WARN(overridden)" :else "WARN");
      print("%s:%v: %s: %s(): called with %v positional argument(s), but %s accepts at most %v -- likely a missing keyword before this argument, or an extra argument\n"
        target stmtline wtag name obsnarg name maxargs);
      if(stmtallowed :then nwarnok=nwarnok+1 :else nwarn=nwarn+1))))

if(stmtnlines>0 :then
  print("%s: warning: unbalanced parens in trailing %v line(s) starting at line %v -- not checked\n"
    target stmtnlines stmtlineno);
  nskipped=nskipped+stmtnlines)

close(fp)

print("\ncomlint: %v call(s) checked, %v line(s) skipped, %v fail(s), %v warn(s), %v warn(s) overridden, %v help() cache miss(es)\n"
  nchecked nskipped nfail nwarn nwarnok nhelpcalls)
if(nfail>0 || nwarn>0 :then exit(1))
exit(0)
