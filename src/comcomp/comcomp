#! /usr/bin/env comterp_run
#
# comcomp  translate a ComTerp func's body into Go source, natively --
#          the tree-walking compiler lives in src/comcomp/funccompile.comt
#
# Usage:  comcomp script.comt funcname [outfile]
#
# Runs script.comt (this needs the live FuncObj, unlike comlint's
# static-only analysis), fetches funcname's own postfix(:tree)
# natively, and compiles it to a Go function body in-process --
# funccompile.comt, loaded via run() so it shares this scope, is a
# ComTerp-native port of the original funccompile.go (still kept at
# src/comcomp/translate for the from-a-separate-process case). No
# shell(), no pipe, no separate binary.
#
# Coverage is exactly funccompile.comt's own: a single-array-param func
# made of assign/for/while/@-read/@-write/size/+-*//comparisons/&&/||,
# ending by returning that same array -- anything else is a compile
# error (nil), not a silent fallback. See
# src/comcomp/funccompile.comt.

if(arg(1)=="help" || arg(1)=="-h" || arg(1)==nil ||
  arg(1)=="-help" || arg(1)=="--help" :then

    print("comcomp  translate a ComTerp func into Go, natively\n");
    print("Usage:  comcomp script.comt funcname [outfile]\n\n");
    print("Runs script.comt, fetches funcname's own postfix(:tree), compiles\n");
    print("it to a Go function body (src/comcomp/funccompile.comt), and\n");
    print("prints it (or writes it to outfile if given). See\n");
    print("src/comcomp/funccompile.comt for exactly which ComTerp\n");
    print("primitives this spike covers.\n");
    exit)

target=arg(1)
funcname=arg(2)
outfile=arg(3)

if(funcname==nil :then
  print("comcomp: missing funcname -- usage: comcomp script.comt funcname [outfile]\n" :err);
  exit(1))

fp=open(target "r")
if(fp==nil :then
  print("comcomp: unable to open %s\n" target :err);
  exit(1))
close(fp)

selfpath=arg(0)
lastslash=index(selfpath "/" :last)
scriptdir=if(lastslash==nil :then "." :else substr(selfpath lastslash))
run(scriptdir+"/funccompile.comt")

run(target)

/* funcname is interpolated into eval()'d command text, not a shell
   command -- info()/postfix() parse without firing anything, the same
   non-executing lookup comlint uses for help()/istype() on a
   dynamically-named command. */
srccmd=print("info(%s).source" funcname :str)
srclines=eval(srccmd)
if(srclines==nil :then
  print("comcomp: %s has no source (not a func, or not found in %s)\n" funcname target :err);
  exit(1))

/* info(f).source comes back as one string per original source line
   (not one string with embedded newlines), so it's rejoined here
   before being handed to postfix(). */
src="";si=0
while(si<size(srclines)
  src=src+at(srclines si);
  si=si+1)

treecmd=print("postfix(%s :tree)" src :str)
tree=eval(treecmd)
if(!islist(tree) :then
  print("comcomp: %s's source didn't parse to a tree\n" funcname :err);
  exit(1))

body=fc_compile_func(tree)
if(body==nil :then
  print("comcomp: %s isn't a single-array-param func ending by returning its own array -- see src/comcomp/funccompile.comt for the exact shape required\n" funcname :err);
  exit(1))

if(outfile!=nil :then
  wf=open(outfile "w");
  print("%s" body :file wf);
  close(wf);
  print("comcomp: wrote %s\n" outfile)
:else
  print("%s" body))

exit(0)
